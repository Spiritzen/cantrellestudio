---
import SeoHead from "../components/seo/SeoHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
// CS-S2C : typographies de production, chargées globalement et
// auto-hébergées (aucune requête Google Fonts). Syne n'est volontairement
// PAS importée ici : elle reste réservée au Design Lab
// (src/pages/design-lab.astro), qui l'importe lui-même.
import "@fontsource-variable/sora";
import "@fontsource-variable/manrope";
import "../styles/global.css";
// Micro-sprint pré-déploiement GitHub Pages — aucun <link rel="icon"> n'existait
// jusqu'ici : le favicon fonctionnait en dev (fallback navigateur implicite
// sur `/favicon.ico`, racine = base actuelle `/`) mais sous un sous-chemin
// GitHub Pages ce fallback pointerait vers la racine du DOMAINE
// (`https://spiritzen.github.io/favicon.ico`, inexistant), pas vers
// `/cantrellestudio/favicon.ico`. Déclaration explicite et base-aware.
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  /** CS-S2B : transmis tel quel à SeoHead, défaut false (voir SeoHead.astro). */
  noindex?: boolean;
  /** CS-S12A : transmis tel quel à SeoHead, défaut true (voir SeoHead.astro). */
  nofollow?: boolean;
  /** CS-S12B : transmis tel quel à SeoHead (chemin racine, override du
   * fallback OG global). Voir SeoHead.astro. */
  image?: string;
  /** CS-S12B : transmis tel quel à SeoHead (alt de `image`). */
  imageAlt?: string;
}

const { title, description, noindex = false, nofollow = true, image, imageAlt } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico")} />
    <SeoHead title={title} description={description} noindex={noindex} nofollow={nofollow} image={image} imageAlt={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu principal</a>
    <Header />
    {/* CS-S13 — audit clavier : sans `tabindex="-1"`, activer le lien
        d'évitement déplace le scroll (ancre `#main-content`) mais PAS le
        focus DOM réel (un `<main>` sans tabindex n'est pas programmatiquement
        focusable) — vérifié réellement (`document.activeElement` restait en
        dehors de `<main>` après activation). `tabindex="-1"` le rend
        focusable par script/fragment sans l'ajouter à l'ordre de tabulation
        normal (aucun changement pour la navigation Tab séquentielle). */}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
