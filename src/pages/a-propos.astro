---
// À propos / Studio — CS-S11B. Remplace le placeholder CS-S0 (H1 nu +
// 1 paragraphe) par une vraie page « Studio », distincte de /methode/
// (prompt §1/§6) : répond à « qui porte le studio, comment travaille-t-il,
// pourquoi lui confier un projet » — jamais à « pourquoi recruter
// Sébastien » (pas de CV, pas de portrait, pas de chronologie de carrière).
//
// CS-S12D — maillage SEO local (prompt §11 : "À PROPOS → ... éventuellement
// landing Amiens si naturelle") : une 3ᵉ phrase courte ajoutée en fin de
// bio (jamais une réécriture des 2 paragraphes déjà validés en CS-S11B),
// mention factuelle + lien vers /developpement-web-amiens/. Rien d'autre
// modifié sur cette page.
//
// Composants Services réutilisés tels quels (génériques, déjà utilisés par
// /methode/ et les 3 pages services) : ServiceBreadcrumb, ServiceHero,
// ServiceCta. GOTCHA vérifié par build réel avant d'écrire cette page :
// /methode/ utilise ces 3 composants mais n'importe QUE methode.css, alors
// que leurs classes (.service-hero/.service-cta/.service-breadcrumb) sont
// définies dans services.css — inspection du CSS buildé
// (dist/_astro/BaseLayout.*.css référencé par methode/index.html) confirme
// qu'aucune de ces classes n'y est présente : /methode/ rend donc ces 3
// blocs SANS LEURS STYLES (hero/cta/breadcrumb non stylés). Bug préexistant
// hors périmètre (méthode.astro est interdit de modification ici, prompt
// §13) — signalé au rapport, NON reproduit ici : cette page importe
// explicitement services.css en plus de a-propos.css pour que ces 3
// composants partagés s'affichent correctement.
//
// Section « Fondateur » (C) : aucun portrait n'existe dans le projet
// (vérifié : src/assets/ ne contient que des captures projets + un HDR +
// un GLB) — composition typographique pure (initiales en filigrane),
// conformément au prompt §C "sinon : ne pas inventer/générer/substituer un
// portrait".
//
// Dette ARIA (signalée CS-S11A, corrigée CS-S11D) : ServiceCta.astro pose
// désormais un id sur son <h2> via la prop optionnelle `headingId` — la
// section G (CTA final) passe `headingId="about-cta-title"` et porte de
// nouveau `aria-labelledby="about-cta-title"`, qui pointe maintenant vers
// un élément réel (voir ServiceCta.astro pour le détail du hotfix).
//
// MAJ sprint « implémentation DA » : le reveal est désormais à classes (.about-r / .is-in) avec replay
// et hystérésis 33 % / 7 % (voir script en bas de page) ; le paragraphe ci-dessous décrit la V1.
// Motion (§9) : le prompt demande explicitement de NE PAS élargir
// ServiceMotion.astro par facilité et d'évaluer d'abord un mécanisme local
// CSS/IntersectionObserver léger. C'est le choix retenu ici : un unique
// script bas de page (aucune dépendance, aucun GSAP), reveal PAR SECTION
// (pas par élément) — plus simple que le stagger multi-éléments des autres
// pages, ce qui est aussi une différenciation éditoriale volontaire
// (prompt §6). État initial masqué posé par JS uniquement (pas par CSS) :
// sans JS, chaque section reste visible par défaut (même garantie que
// HomeMotion/ServiceMotion).
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import ServiceBreadcrumb from "../components/services/ServiceBreadcrumb.astro";
import ServiceHero from "../components/services/ServiceHero.astro";
import ServiceCta from "../components/services/ServiceCta.astro";
import ExpertiseDotWave from "../components/motion/ExpertiseDotWave.astro";
import PageFilaments from "../components/hero/PageFilaments";
import { withBase } from "../utils/paths";
import "../styles/services.css";
import "../styles/a-propos.css";

const axes = [
  {
    index: "01",
    label: "Comprendre",
    title: "Le contexte avant les outils",
    text: "Les utilisateurs, les processus, les contraintes et l'existant donnent le cadre des décisions à prendre.",
  },
  {
    index: "02",
    label: "Structurer",
    title: "Donner une forme claire au besoin",
    text: "Parcours, données, règles métier et architecture sont organisés avant d'empiler les fonctionnalités.",
  },
  {
    index: "03",
    label: "Construire",
    title: "Faire des choix qui restent maîtrisables",
    text: "La technologie, l'interface et le niveau de complexité doivent rester proportionnés au produit réellement nécessaire.",
  },
];

const workingRelationPoints = [
  "Une continuité entre besoin et réalisation.",
  "Des arbitrages expliqués plutôt qu'imposés.",
  "Un périmètre qui reste lisible au fil du projet.",
];

const principles = [
  { word: "Clarté", text: "Une solution doit pouvoir être comprise avant d'être complexifiée." },
  { word: "Cohérence", text: "Produit, interface et architecture doivent raconter la même chose." },
  { word: "Maîtrise", text: "Chaque ajout technique doit avoir une raison d'exister." },
  { word: "Évolution", text: "Une base propre doit pouvoir accueillir la suite sans devenir un obstacle." },
];

const realisations = (await getCollection("realisations")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="À propos de Cantrelle Studio | Conception & développement"
  description="Découvrez Cantrelle Studio, studio indépendant fondé par Sébastien Cantrelle : conception, développement et solutions numériques pensées à partir du besoin réel."
>
  <div class="about-page">
    <!-- Filaments d'arrière-plan : composant existant, monté une fois, desktop
         uniquement (aucune hydratation sous 900 px). -->
    <PageFilaments client:media="(min-width: 900px)" />

    <Container>
      <ServiceBreadcrumb current="À propos" />
    </Container>

    <!-- A. HERO — LE STUDIO -->
    <!-- Ouverture du Hero : le marqueur est posé AVANT le premier rendu du Hero (aucun flash) et
         seulement si le mouvement est permis ; sans JS ou en reduced-motion, le Hero reste à son
         état final visible. Les animations (CSS, une seule fois) se terminent d'elles-mêmes. -->
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("about-intro");
    </script>

    <section class="about-page__section about-hero">
      <Container>
        <div class="about-hero-layout">
          <div>
            <ServiceHero
              eyebrow="Le studio"
              title="Concevoir des solutions numériques qui partent du besoin réel."
              lead="Cantrelle Studio est un studio indépendant de conception et de développement, fondé par Sébastien Cantrelle. Applications métier, SaaS, sites professionnels ou besoins plus spécifiques : chaque projet commence par comprendre ce qu'il faut réellement résoudre avant de choisir comment le construire."
              secondaryHref="/methode/"
              secondaryLabel="Découvrir la méthode"
            />
          </div>
          <!-- Décor abstrait (CSS pur) : trois cercles qui se recoupent = métier / technique /
               expérience reliés. Purement décoratif, aucun contenu essentiel. -->
          <div class="about-venn" aria-hidden="true">
            <span class="about-venn__circle about-venn__circle--a"></span>
            <span class="about-venn__circle about-venn__circle--b"></span>
            <span class="about-venn__circle about-venn__circle--c"></span>
            <span class="about-venn__core"></span>
            <span class="about-venn__label about-venn__label--a">Métier</span>
            <span class="about-venn__label about-venn__label--b">Technique</span>
            <span class="about-venn__label about-venn__label--c">Expérience</span>
          </div>
        </div>
      </Container>
    </section>

    <!-- B. UNE FAÇON DE RELIER LES SUJETS -->
    <section class="about-page__section about-page__section--soft about-approach" aria-labelledby="about-approach-title">
      <!-- Champ de points : unique apparition sur cette page (le champ « relie » les 3 sujets). -->
      <ExpertiseDotWave />
      <Container>
        <div class="about-approach-layout">
          <div class="about-approach-main" data-reveal>
            <span class="about-eyebrow">Approche</span>
            <h2 id="about-approach-title">Métier, technique et expérience ne sont pas <span class="about-accent">trois sujets séparés</span>.</h2>
            <p class="about-lead">Une interface réussie ne compense pas une logique métier mal comprise. Une architecture solide ne suffit pas si le produit reste difficile à utiliser. Le rôle du studio est de relier ces dimensions pour construire une solution cohérente dans son ensemble.</p>
          </div>
          <div class="about-axes">
            {axes.map((axis, i) => (
              <div class={i === axes.length - 1 ? "about-axis about-axis--final" : "about-axis"} data-reveal>
                <span class="about-axis__index" aria-hidden="true">{axis.index}</span>
                <div class="about-axis__body">
                  <span class="about-axis__label">{axis.label}</span>
                  <h3 class="about-axis__title">{axis.title}</h3>
                  <p class="about-axis__text">{axis.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <!-- C. LE FONDATEUR -->
    <section class="about-page__section about-founder-section" aria-labelledby="about-founder-title">
      <Container>
        <div class="about-founder">
          <div class="about-founder__mark" aria-hidden="true">SC</div>
          <div class="about-founder__content" data-reveal>
            <span class="about-founder__eyebrow">Fondateur</span>
            <h2 id="about-founder-title" class="about-founder__title">Sébastien Cantrelle</h2>
            <p class="about-founder__role">Fondateur · Développeur Full Stack</p>
            <p class="about-founder__text">
              Mon parcours associe développement logiciel, gestion de projet et sensibilité visuelle 2D/3D. Cette
              combinaison me pousse à regarder un projet au-delà du code&nbsp;: comprendre l'activité, structurer le
              problème, concevoir une expérience claire puis construire une solution capable d'évoluer.
            </p>
            <p class="about-founder__text">
              Cantrelle Studio est né de cette manière de travailler&nbsp;: garder une relation directe avec le
              besoin tout en apportant la rigueur technique nécessaire à une application métier, un SaaS ou un site
              professionnel.
            </p>
            <p class="about-founder__text">
              Basé à Amiens, il accompagne des projets locaux dans les Hauts-de-France ainsi qu'à distance partout en
              France. <ActionLink href="/developpement-web-amiens/" variant="text">Développement web à Amiens</ActionLink>
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- D. STRUCTURE LÉGÈRE, RESPONSABILITÉ DIRECTE -->
    <section class="about-page__section about-page__section--soft about-relation" aria-labelledby="about-work-title">
      <ExpertiseDotWave />
      <Container>
        <div data-reveal>
          <SectionHeading
            id="about-work-title"
            eyebrow="Relation de travail"
            title="Un interlocuteur direct, du cadrage aux décisions techniques."
            intro="Cantrelle Studio fonctionne aujourd'hui avec une structure légère : la compréhension du besoin, les arbitrages de conception et les décisions techniques restent reliés au même interlocuteur. Cela évite que le projet se dilue entre des couches d'intermédiaires et permet de garder les choix compréhensibles."
          />
        </div>
        <ul class="about-work-points" data-reveal>
          {workingRelationPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </Container>
    </section>

    <!-- E. UNE CULTURE DE LA CONSTRUCTION -->
    <section class="about-page__section about-exigence" aria-labelledby="about-culture-title">
      <Container>
        <div data-reveal>
          <SectionHeading id="about-culture-title" eyebrow="Exigence" title="Faire juste avant de faire plus." />
        </div>
        <div class="about-principles">
          {principles.map((principle) => (
            <div class="about-principle" data-reveal>
              <span class="about-principle__word">{principle.word}</span>
              <p class="about-principle__text">{principle.text}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- F. LES PREUVES SONT DANS LES PROJETS -->
    <section class="about-page__section about-page__section--soft about-proof" aria-labelledby="about-proof-title">
      <ExpertiseDotWave />
      <Container>
        <!-- Titre rendu localement (accent partiel « cohérence » ; SectionHeading non modifié). -->
        <div class="about-proof-heading" data-reveal>
          <span class="about-eyebrow">Réalisations</span>
          <h2 id="about-proof-title">Des contextes différents, une même exigence de <span class="about-accent">cohérence</span>.</h2>
          <p class="about-lead">Applications métier, SaaS ou expérience web : les études de cas montrent plus concrètement comment les besoins, les contraintes et les choix techniques se traduisent dans les projets.</p>
        </div>
        <ul class="about-proof-list">
          {realisations.map((realisation, i) => (
            <li data-reveal>
              <a href={withBase(`/realisations/${realisation.data.slug}/`)}>
                <span class="about-proof-list__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="about-proof-list__category">{realisation.data.category}</span>
                <span class="about-proof-list__title">{realisation.data.shortTitle ?? realisation.data.title}</span>
                <span class="about-proof-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="about-proof-cta" data-reveal>
          <ActionLink href="/realisations/" variant="text">Voir les réalisations</ActionLink>
        </p>
      </Container>
    </section>

    <!-- G. CTA FINAL -->
    <section class="about-page__section about-final" aria-labelledby="about-cta-title">
      <Container>
        <div data-reveal>
          <ServiceCta
            headingId="about-cta-title"
            eyebrow="Votre projet"
            title="Un besoin à clarifier ou une solution à construire ?"
            text="Le premier échange sert à comprendre le contexte, le besoin et le niveau d'accompagnement pertinent avant de parler technologie."
            secondaryHref="/methode/"
            secondaryLabel="Voir la méthode"
          />
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>

<script>
  // Reveal local, propre à /a-propos/ (ServiceMotion non utilisé ni modifié). Les
  // éléments [data-reveal] entrent (opacité + léger décalage) quand ils sont visibles à
  // 33 % et se réarment seulement sous 7 % : rejoué au retour, sans clignotement
  // (hystérésis). Aucun écouteur de scroll, aucune boucle. Non armé sous
  // prefers-reduced-motion : tout reste visible. Sans JS : tout reste visible.
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion && "IntersectionObserver" in window) {
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
    targets.forEach((el) => el.classList.add("about-r"));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target as HTMLElement;
          if (entry.intersectionRatio >= 0.33 || (entry.isIntersecting && entry.intersectionRatio > 0.15 && entry.boundingClientRect.height > window.innerHeight * 0.6)) {
            el.classList.add("is-in");
          } else if (entry.intersectionRatio < 0.07) {
            el.classList.remove("is-in");
          }
        });
      },
      { threshold: [0, 0.03, 0.07, 0.15, 0.25, 0.33, 0.5] },
    );

    targets.forEach((el) => observer.observe(el));
  }

  // « Exigence » : effet HeliFan sobre sur les 4 cards (pointeur fin, >= 900 px, jamais en
  // reduced-motion). Tilt <= 2.2°, translateY -2 px, scale 1.004, halo --px/--py ; retour
  // au repos en 600 ms (transition CSS). Seules des variables CSS sont posées : aucun style
  // inline de transform, aucune boucle, aucune capture du pointeur.
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  if (fine.matches && !prefersReducedMotion) {
    const MAX_X = 1.8;
    const MAX_Y = 2.2;
    const wide = window.matchMedia("(min-width: 900px)");
    document.querySelectorAll<HTMLElement>(".about-exigence .about-principle").forEach((card) => {
      card.addEventListener("pointermove", (e: PointerEvent) => {
        if (!wide.matches) return;
        const r = card.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
        const y = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
        card.classList.add("is-tilting");
        card.style.setProperty("--rx", `${(-y * MAX_X).toFixed(2)}deg`);
        card.style.setProperty("--ry", `${(x * MAX_Y).toFixed(2)}deg`);
        card.style.setProperty("--ty", "-2px");
        card.style.setProperty("--sc", "1.004");
        card.style.setProperty("--px", `${((x + 1) / 2) * 100}%`);
        card.style.setProperty("--py", `${((y + 1) / 2) * 100}%`);
      });
      card.addEventListener("pointerleave", () => {
        card.classList.remove("is-tilting");
        ["--rx", "--ry", "--ty", "--sc"].forEach((p) => card.style.removeProperty(p));
        card.style.setProperty("--px", "50%");
        card.style.setProperty("--py", "50%");
      });
    });
  }

  // « Réalisations » : halo radial Ember très faible qui suit le pointeur sur chaque rail
  // (variables --px / --py, pointeur fin, >= 900 px, jamais en reduced-motion). Pas de tilt.
  if (fine.matches && !prefersReducedMotion) {
    const wideRails = window.matchMedia("(min-width: 900px)");
    document.querySelectorAll<HTMLElement>(".about-proof-list a").forEach((rail) => {
      rail.addEventListener("pointermove", (e: PointerEvent) => {
        if (!wideRails.matches) return;
        const r = rail.getBoundingClientRect();
        rail.style.setProperty("--px", `${((e.clientX - r.left) / r.width) * 100}%`);
        rail.style.setProperty("--py", `${((e.clientY - r.top) / r.height) * 100}%`);
      });
      rail.addEventListener("pointerleave", () => {
        rail.style.removeProperty("--px");
        rail.style.removeProperty("--py");
      });
    });
  }
</script>
