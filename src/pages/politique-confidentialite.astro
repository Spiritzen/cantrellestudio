---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Politique de confidentialité — Cantrelle Studio"
  description="Politique de confidentialité de Cantrelle Studio — page à compléter avant mise en ligne."
>
  <section class="container">
    <h1>Politique de confidentialité</h1>
    <p class="placeholder-legal">
      Cette page est un placeholder. Aucune donnée juridique n'a été
      inventée. Ce contenu devra être complété avec des informations réelles
      (traitement des données, cookies éventuels, etc.) avant toute mise en
      ligne.
    </p>
  </section>
</BaseLayout>

<style>
  section {
    padding-block: var(--space-lg);
  }
  .placeholder-legal {
    border: 1px dashed var(--color-border);
    padding: var(--space-sm);
    color: var(--color-text-muted);
  }
</style>
