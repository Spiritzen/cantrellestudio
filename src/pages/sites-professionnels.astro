        <p class="service-architecture__note sites-journey-method-note">
          <ActionLink href="/methode/" variant="text">Découvrir la méthode complète</ActionLink>
        </p>
      </Container>
    </section>

    <section class="service-page__section service-page__section--soft sites-foundations-section" aria-labelledby="sites-foundations-title">
      <!-- Micro-sprint "DotWave local" — voir commentaire section
           "Positionnement" plus haut, même principe exact. -->
