// Micro-sprint "Fondations, reprise compacte" (PROMPT_CLAUDE_CODE_SITES_PRO_
// FONDATIONS_REPRISE_COMPACTE) — la démonstration interactive du sprint
// précédent (grand navigateur fictif + 4 sélecteurs + panneau dynamique,
// composant FoundationsDemo.astro) est REJETÉE par Sébastien (parcours du
// regard compliqué, section trop haute/technique) et intégralement retirée
// (composant supprimé, import retiré, CSS dédiée supprimée — voir
// services.css). Remplacée par UNE grille statique de 4 cartes de même
// famille visuelle, sans aucune interaction/JS : copie VALIDÉE mot pour mot
// du prompt.
const foundationCards = [
  {
    id: "01",
    title: "Être plus facile à trouver",
    text: "Des pages claires et bien organisées pour aider vos futurs clients à découvrir votre activité.",
    technical: "Référencement naturel · SEO",
    icon: "search",
  },
  {
    id: "02",
    title: "Ne pas faire attendre",
    text: "Un site léger et rapide, pour accéder facilement aux informations qui comptent.",
    technical: "Performance · Chargement optimisé",
    icon: "bolt",
  },
  {
    id: "03",
    title: "Être agréable sur tous les écrans",
    text: "Une présentation qui s'adapte au téléphone, à la tablette et à l'ordinateur.",
