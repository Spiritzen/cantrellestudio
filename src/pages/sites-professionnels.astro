            imageAlt={externalProjectMedia.velocean.alt}
          />
        </div>
        <p class="service-architecture__note">D'autres projets sont présentés dans les <a href={withBase("/realisations/")}>réalisations</a>.</p>
      </Container>
    </section>

    <section class="service-page__section service-page__section--soft sites-tech-section" aria-labelledby="sites-tech-title">
      <!-- Micro-sprint "DotWave local" — voir commentaire section
           "Positionnement" plus haut, même principe exact. -->
