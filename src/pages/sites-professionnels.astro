                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
              )}
              {card.icon === "bolt" && (
                <svg class="foundations-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              )}
              {card.icon === "responsive" && (
                <svg class="foundations-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="14" height="10" rx="1.2" />
                  <rect x="13" y="10" width="8" height="12" rx="1.5" />
                </svg>
              )}
              {card.icon === "accessibility" && (
                <svg class="foundations-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="5" r="1.75" />
                  <path d="M12 9v6" />
                  <path d="M8 11h8" />
                  <path d="M9 20l3-5 3 5" />
                </svg>
              )}
              <h3 class="foundations-card__title">{card.title}</h3>
              <p class="foundations-card__text">{card.text}</p>
              <p class="foundations-card__technical">{card.technical}</p>
            </div>
          ))}
        </div>
        <!-- Micro-sprint "Suppression Choix technique, message Fondations"
             (PROMPT_CLAUDE_CODE_SITES_PRO_SUPPRESSION_CHOIX_TECHNIQUE_
             MESSAGE_FONDATIONS) — la section "CHOIX TECHNIQUE" (Astro/React,
             DotWave dédié) est retirée ENTIÈREMENT de la page (voir plus bas :
             elle n'existe plus entre Preuves et SEO honnête). Son idée
             essentielle survit sous cette forme : une conclusion courte
             APRÈS les 4 cartes, dans le même conteneur — jamais une 5e
             carte, jamais un nouveau panneau, aucun CTA ajouté. -->
        <div class="foundations-conclusion" data-motion="block">
          <h3 class="foundations-conclusion__title">La bonne solution, sans complexité inutile.</h3>
          <p class="foundations-conclusion__text">
            Chaque projet est différent. Nous choisissons les outils adaptés à votre activité, à vos besoins et à
            votre budget, pour construire un site fiable et capable d'évoluer avec vous.
          </p>
        </div>
      </Container>
    </section>

    <section class="service-page__section sites-proofs-section" aria-labelledby="sites-proofs-title">
      <Container>
        <SectionHeading
          id="sites-proofs-title"
          eyebrow="Preuves"
          title="Des sites pensés autour de chaque activité."
          intro="Trois univers différents, une même attention portée à la présentation des services, à l'expérience des visiteurs et à la prise de contact."
        />
        <div class="sites-proofs-grid">
          {proofCards.map((card) => (
            <article class:list={["sites-proof-card", `sites-proof-card--${card.role}`, `sites-proof-card--${card.id}`]} data-motion="proof">
              <span class="sites-proof-card__label">{card.label}</span>
              <div class="sites-proof-card__body">
                <a class="sites-proof-card__media" href={card.demoHref} target="_blank" rel="noopener noreferrer" aria-label={card.demoLabel}>
                  <Picture
                    src={card.image}
                    alt={card.imageAlt}
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={card.role === "primary" ? [320, 640, 900, 1238, 1600, 1902] : [320, 480, 640]}
                    sizes={card.role === "primary" ? "(min-width: 1320px) 1238px, calc(100vw - 5rem)" : "(min-width: 900px) 30vw, 100vw"}
                    loading="lazy"
                    decoding="async"
                    class="sites-proof-card__img"
                  />
                </a>
                <div class="sites-proof-card__content">
                  <h3 class="sites-proof-card__title">
                    <a class="sites-proof-card__title-link" href={card.demoHref} target="_blank" rel="noopener noreferrer" aria-label={card.demoLabel}>{card.title}</a>
                    <a class="sites-proof-card__demo-link" href={card.demoHref} target="_blank" rel="noopener noreferrer" aria-label={card.demoLabel}>
                      Voir la maquette <span aria-hidden="true">→</span>
                    </a>
                  </h3>
                  <p class="sites-proof-card__description">{card.description}</p>
                  <p class="sites-proof-card__keywords">{card.keywords}</p>
                  {card.caseHref && (
                    <a class="sites-proof-card__case-link" href={withBase(card.caseHref)}>
                      Voir l'étude de cas {card.title} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="service-architecture__note">D'autres projets sont présentés dans les <a href={withBase("/realisations/")}>réalisations</a>.</p>
      </Container>
    </section>

    <section class="service-page__section sites-honesty-section" aria-labelledby="sites-honesty-title">
      <Container>
        <SectionHeading id="sites-honesty-title" eyebrow="SEO honnête" title="Une base solide, pas une promesse de classement." />
        <div class="service-honesty" data-motion="block">
          <p class="service-honesty__statement">
            Le studio peut construire une base technique et éditoriale solide. Personne ne peut promettre une
            position précise dans Google.
          </p>
          <p>Ce qui peut être travaillé : la qualité technique, les contenus, la structure, la performance et le suivi dans le temps.</p>
        </div>

        <div class="service-faq" data-motion="block">
          <details>
            <summary>Astro ou React pour un site professionnel ?</summary>
            <p>
              Cela dépend du besoin : un site de contenu ou une vitrine tire parti d'Astro (rendu statique, SEO,
              performance). Une partie plus interactive ou applicative s'appuie davantage sur React. Le choix se fait
              projet par projet, pas par défaut.
            </p>
          </details>
          <details>
            <summary>Peut-on garantir une première position dans Google ?</summary>
            <p>
              Non — personne ne peut le garantir honnêtement. Ce qui peut l'être : une base technique et éditoriale
              solide (SEO technique, structure, contenu utile, performance).
            </p>
          </details>
          <details>
            <summary>Le site peut-il évoluer plus tard ?</summary>
            <p>
              Oui. L'architecture est pensée pour ajouter des pages ou des fonctionnalités sans tout refaire — voir
              <a href={withBase("/developpement-sur-mesure/")}>développement sur mesure</a> pour les évolutions plus poussées.
            </p>
          </details>
        </div>
      </Container>
    </section>

    <section class="service-page__section service-page__section--soft sites-final-cta-section" aria-labelledby="sites-cta-title">
      <!-- Micro-sprint "DotWave local" — voir commentaire section
           "Positionnement" plus haut, même principe exact. Points en
           décoration de fond de la SECTION, derrière la carte CTA
           (`.service-cta`, opaque) : jamais par-dessus son texte/boutons,
           jamais dans le footer (ce composant n'est monté que dans cette
           section). -->
      <ExpertiseDotWave />
      <Container>
        <ServiceCta
          headingId="sites-cta-title"
          eyebrow="Un site à créer ou à repenser ?"
          title="Parlons de ce que votre site doit vraiment faire."
          text="Être trouvé, être compris, être contacté : commençons par le besoin réel derrière le site."
          secondaryHref="/realisations/"
          secondaryLabel="Voir les réalisations"
        />
      </Container>
    </section>
  </div>

  <ServiceMotion />
</BaseLayout>
