// Micro-sprint "Positionnement interactif" (PROMPT_CLAUDE_CODE_SITES_PRO_
// POSITIONNEMENT_INTERACTIF_CTA) — remplace l'ancienne grille statique de
// 8 petites cases (`builds`, retirée) : 6 situations client réelles,
// copie VALIDÉE mot pour mot par le prompt, dans l'ORDRE imposé (01 =
// création d'entreprise, sélectionnée par défaut). SOURCE UNIQUE consommée
// par `<PositioningSituations>` (voir ce composant) — jamais dupliquée à
// la main entre desktop et mobile.
//
// Micro-sprint "Positionnement mise en valeur texte" (PROMPT_CLAUDE_CODE_
// SITES_PRO_POSITIONNEMENT_MISE_EN_VALEUR_TEXTE) — `buildSegments` découpe
// CHAQUE texte existant (inchangé, ci-dessous) en segments texte normal /
// texte à mettre en gras, à partir d'une liste de mots choisis par
// Sébastien. Jamais de set:html/innerHTML/remplacement de chaîne brute :
// simple découpage en sous-chaînes, rendu ensuite via de vrais noeuds
// Astro (`<strong>`), donc toujours échappé normalement. Bornage de mot
// Unicode-aware (`\p{L}`/`\p{N}` en lookaround, pas `\b` qui traite les
// lettres accentuées comme non-mot et casserait "activité"/"visibilité"
// en fin de motif) : évite qu'un mot court comme "site" ne matche à
// l'intérieur d'un autre mot (ex. "visiteurs"). Une seule occurrence par
// terme, dans l'ordre où les termes sont listés ; termes qui se
// chevaucheraient ignorés (non utilisé ici mais gardé défensif).
interface Segment {
  text: string;
  strong?: boolean;
}

function buildSegments(text: string, terms: string[]): Segment[] {
  const ranges: { start: number; end: number }[] = [];
  for (const term of terms) {
    const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const pattern = new RegExp(`(?<![\\p{L}\\p{N}_])${escaped}(?![\\p{L}\\p{N}_])`, "u");
    const match = pattern.exec(text);
    if (!match) continue;
    const start = match.index;
    const end = start + match[0].length;
    if (ranges.some((r) => start < r.end && end > r.start)) continue;
    ranges.push({ start, end });
  }
  ranges.sort((a, b) => a.start - b.start);
  const segments: Segment[] = [];
  let cursor = 0;
  for (const range of ranges) {
    if (range.start > cursor) segments.push({ text: text.slice(cursor, range.start) });
    segments.push({ text: text.slice(range.start, range.end), strong: true });
    cursor = range.end;
  }
  if (cursor < text.length) segments.push({ text: text.slice(cursor) });
  return segments;
}

