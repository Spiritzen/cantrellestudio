// Micro-finition "Positionnement" (PROMPT_CLAUDE_CODE_SITES_PRO_
// POSITIONNEMENT_FINITION_EMPHASE) — la phrase de clôture met désormais en
// valeur « solution » (plus « besoins »), de façon IDENTIQUE sur les 6
// panneaux (y compris 01 et 03, qui n'avaient auparavant aucune mise en
// valeur) : un seul calcul, partagé, plutôt qu'un indicateur par situation.
const CLOSING_NOTE_SEGMENTS = buildSegments(SITUATION_CLOSING_NOTE, ["solution"]);

const situations = situationsRaw.map((item) => ({
  id: item.id,
  title: item.title,
  situationSegments: buildSegments(item.situation, item.situationWords),
