    <section class="service-page__section sites-proofs-section" aria-labelledby="sites-proofs-title">
      <Container>
        <SectionHeading id="sites-proofs-title" eyebrow="Preuves" title="Une maquette de refonte, pensée comme un vrai projet." />
        <div class="related-case-study-pair">
          <RelatedCaseStudy
