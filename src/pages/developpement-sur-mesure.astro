// section "Repères" par une présentation éditoriale NON interactive de 3
// principes (voir composant : aucun radio, aucune modale, juste un stagger
// `data-motion="block"` délégué au chemin générique existant de
// ServiceMotion.astro, non modifié).
import CustomPrinciples from "../components/services/CustomPrinciples.astro";
import ServiceCta from "../components/services/ServiceCta.astro";
import ServiceMotion from "../components/services/ServiceMotion.astro";
// Micro-sprint "DotWave 3 sections" (PROMPT_CLAUDE_CODE_DEV_SUR_MESURE_
// DOTWAVE_TROIS_SECTIONS) — réutilisation STRICTE du composant existant
// (Home Expertises/Capacités, Applications "Le point de départ"/"Stack",
// Sites pro "Positionnement"/"Fondations"/CTA final) : ni le composant ni
// expertise-dot-wave.css ne sont modifiés, voir montage dans les 3
// sections ciblées plus bas + stacking scopé `.service-page--custom` dans
// services.css.
import ExpertiseDotWave from "../components/motion/ExpertiseDotWave.astro";
import { projectMedia } from "../data/projectMedia";
import { withBase } from "../utils/paths";
import { caseStudyContent } from "../data/caseStudyContent";
