---

<BaseLayout
  title="Développement web sur mesure & intégrations | Cantrelle Studio"
  description="API, automatisation, intégration, modernisation et outils web spécifiques : une architecture choisie selon votre besoin, votre existant et vos contraintes."
>
  <div class="service-page service-page--custom">
    <!-- Micro-sprint "Filaments / vagues" — couche de fond persistante pour
         TOUTE la page, montée UNE SEULE FOIS ici (jamais par section),
         même montage/directive que sur Applications métier & SaaS et
         Sites professionnels : aucune hydratation sous 900px. -->
    <PageFilaments client:media="(min-width: 900px)" />
    <Container>
      <ServiceBreadcrumb current="Développement sur mesure" />
    </Container>

    <section class="service-page__section custom-hero-section">
      <Container>
        <ServiceHero
          eyebrow="Développement sur mesure"
          title="Des solutions sur mesure quand le besoin ne rentre pas dans une case."
          lead="API, automatisation, modernisation, intégration ou outil spécifique : le studio part de votre contexte technique au lieu d'imposer une stack."
          secondaryHref="/methode/"
          secondaryLabel="Découvrir la méthode"
        />
      </Container>
    </section>

    <section class="service-page__section service-page__section--soft custom-existing-section" aria-labelledby="custom-existing-title">
      <ExpertiseDotWave />
      <Container>
        <SectionHeading
          id="custom-existing-title"
          eyebrow="Point de départ"
          title="Tout ne démarre pas sur une page blanche."
          intro="Quand un existant est déjà en place, le studio commence par l'audit et la compréhension, pas par une réécriture complète."
        />
        <CustomStartingPoint points={startingPoints} />
      </Container>
    </section>

    <section class="service-page__section custom-usecases-section" aria-labelledby="custom-usecases-title">
      <Container>
        <SectionHeading
          id="custom-usecases-title"
          eyebrow="Cas d'usage"
          title="Votre besoin est particulier. Notre réponse aussi."
          intro="Découvrez comment un développement sur mesure peut répondre à des situations concrètes, en s'adaptant à vos outils et à votre façon de travailler."
        />
        <CustomUseCases items={useCaseItems} />
      </Container>
    </section>

    <section class="service-page__section service-page__section--soft custom-proofs-section" aria-labelledby="custom-proofs-title">
      <ExpertiseDotWave />
      <Container>
        <SectionHeading id="custom-proofs-title" eyebrow="Preuves" title="Des besoins atypiques, déjà travaillés." />
        <CustomProofs featured={proofsFeatured} secondary={proofsSecondary} />
        <p class="service-architecture__note">
          D'autres projets sont présentés dans les <a href={withBase("/realisations/")}>réalisations</a>.
        </p>
      </Container>
    </section>

    <section class="service-page__section custom-process-section" aria-labelledby="custom-process-title">
      <Container>
        <SectionHeading
          id="custom-process-title"
          eyebrow="Mode de collaboration"
          title="Comment se déroule un projet sur mesure."
          intro="Les mêmes étapes que pour tout projet du studio, avec une attention particulière portée à l'existant."
        />
        <CustomCollaboration steps={collaborationSteps} />
      </Container>
    </section>

    <section class="service-page__section service-page__section--soft custom-matrix-section" aria-labelledby="custom-matrix-title">
      <ExpertiseDotWave />
      <Container>
        <SectionHeading
          id="custom-matrix-title"
          eyebrow="Repères"
          title="La bonne solution, sans complexité inutile."
          intro="Chaque projet possède ses propres contraintes. Notre rôle est de choisir une approche adaptée à votre activité, à votre environnement et à vos objectifs, sans vous imposer une technologie ou une refonte dont vous n'avez pas besoin."
        />
        <CustomPrinciples principles={principles} />
      </Container>
    </section>

    <section class="service-page__section custom-cta-section" aria-labelledby="custom-cta-title">
      <Container>
        <ServiceCta
          headingId="custom-cta-title"
          eyebrow="Un besoin qui sort du cadre ?"
          title="Parlons de votre existant avant de parler solution."
          text="API, automatisation, modernisation, intégration ou outil spécifique : commençons par votre contexte réel."
          secondaryHref="/realisations/"
          secondaryLabel="Voir les réalisations"
        />
      </Container>
    </section>
  </div>

  <ServiceMotion />
</BaseLayout>
