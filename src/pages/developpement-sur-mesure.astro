---
// Développement sur mesure — CS-S9. Landing commerciale + SEO on-page.
// Remplace le contenu provisoire CS-S0. BeatStudio / MyDashServ / GlassTrack
// proviennent du Source Pack (src/data/serviceProofs.ts) : GlassTrack doit
// toujours afficher explicitement "démonstrateur" et ne jamais être
// présenté comme une mission Saverglass (prompt §24/§45). Signature
// visuelle de cette page (prompt §31) : connexions / modules / existant /
// intégration — diagramme "hub" (existant au centre, modules autour),
// volontairement différent de la chaîne verticale de la page Applications.
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
// Micro-sprint "Filaments / vagues" (PROMPT_CLAUDE_CODE_DEV_SUR_MESURE_
// FILAMENTS_VAGUES_EXISTANTES) — réutilisation STRICTE du composant
// existant (Canvas Three.js/R3F fixed plein viewport, déjà validé sur
// Applications métier & SaaS et Sites professionnels) : ni le composant
// ni son montage/directive ne sont modifiés, voir plus bas.
import PageFilaments from "../components/hero/PageFilaments";
import ServiceBreadcrumb from "../components/services/ServiceBreadcrumb.astro";
import ServiceHero from "../components/services/ServiceHero.astro";
// Micro-sprint "Point de départ interactif + footer" (PROMPT_CLAUDE_CODE_
// DEV_SUR_MESURE_POINT_DE_DEPART_INTERACTIF_FOOTER) — remplace l'ancienne
// liste statique `.service-chips` de la section "Point de départ" (prompt
// §2/§3/§4, voir composant pour le mécanisme desktop/mobile).
import CustomStartingPoint from "../components/services/CustomStartingPoint.astro";
// Micro-sprint "Cas d'usage interactif" (PROMPT_CLAUDE_CODE_DEV_SUR_MESURE_
// CAS_USAGE_INTERACTIF) — remplace l'ancienne liste `.service-chips` (6
// étiquettes) + le diagramme "hub" (`.service-hub`) de la section "Cas
// d'usage" par 4 situations client cliquables + 1 panneau explicatif (voir
// composant pour le mécanisme desktop/mobile, indépendant de Point de
// départ).
import CustomUseCases from "../components/services/CustomUseCases.astro";
// Micro-sprint "Preuves Sereno/AgencyOS/Trajet Formateur" (PROMPT_CLAUDE_
// CODE_DEV_SUR_MESURE_PREUVES_SERENO_AGENCYOS_TRAJET_FORMATEUR) — remplace
// `RelatedCaseStudy`×2 (Sereno/AgencyOS) + `ServiceProofCard` (GlassTrack,
// retiré de CETTE section — toujours défini dans serviceProofs.ts, non
// supprimé du projet) par une carte vedette (Sereno) + 2 cartes secondaires
// (AgencyOS, Trajet Formateur).
import CustomProofs from "../components/services/CustomProofs.astro";
// Micro-sprint "Mode de collaboration, parcours interactif" (PROMPT_
// CLAUDE_CODE_DEV_SUR_MESURE_MODE_COLLABORATION_PARCOURS_INTERACTIF) —
// remplace la rangée statique `.service-process` de la section "Mode de
// collaboration" par un parcours chronologique interactif en 5 étapes
// (voir composant : ni la mise en page "choix gauche/panneau droite" ni la
// modale mobile des sections précédentes ne sont réutilisées ici).
import CustomCollaboration from "../components/services/CustomCollaboration.astro";
// Micro-sprint "Repères, réassurance finale" (PROMPT_CLAUDE_CODE_DEV_SUR_
// MESURE_REPERES_REASSURANCE_FINALE) — remplace le tableau technique
