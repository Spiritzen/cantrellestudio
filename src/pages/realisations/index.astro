---
// /realisations/ — showroom éditorial : 3 grands panneaux (grand média réel
// + contenu court + 3 preuves + CTA) en alternance gauche/droite.
//
// Données : collection `realisations` (title/category/summary, textes
// existants) + `projectMedia` (média principal et alt existants) ; aucune
// donnée ni image inventée. Les chips reprennent des éléments déjà énoncés
// dans le résumé ou dans `proves` de caseStudyContent.ts. Belkhir est un
// projet client en validation : jamais présenté « en production ».
//
// Hover : langage visuel du Hero de /applications-metier-saas/
// (ProjectHeroVisual.astro : anneau Ember, halo radial piloté par --px/--py,
// pointeur fin uniquement, retour doux, reduced-motion) mais en version très
// atténuée pour de grands panneaux (tilt ≤ 2°, scale panneau 1.005, média
// 1.015). JS Astro pur, aucune dépendance. Tout est local à ce fichier.
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ActionLink from "../../components/ui/ActionLink.astro";
// Lignes décoratives : composant EXISTANT des pages services (filaments, canvas
// fixe z-index:-1, hydraté dès 900px, reduced-motion géré par le composant),
// importé tel quel, jamais modifié. Voir le fond du showroom plus bas : un
// dégradé opaque le recouvre sous le Hero, les lignes restent donc dans
// l'espace du Hero.
import PageFilaments from "../../components/hero/PageFilaments";
import { projectMedia } from "../../data/projectMedia";
import { withBase } from "../../utils/paths";

const collection = await getCollection("realisations");

// Ordre éditorial imposé + preuves (chips) par projet.
const panels = [
  { slug: "sereno", chips: ["Facturation électronique", "Conformité Factur-X", "Workflow métier"] },
  { slug: "agencyos", chips: ["SaaS multi-tenant", "CRM & projets", "Facturation & pilotage financier"] },
  { slug: "belkhir-depannage", chips: ["Architecture SEO", "Mobile-first", "Site d'urgence"] },
].flatMap((p) => {
  const entry = collection.find((e) => e.data.slug === p.slug);
  const media = projectMedia[p.slug];
  if (!entry || !media) return [];
  return [
    {
      slug: p.slug,
      chips: p.chips,
      title: entry.data.shortTitle ?? entry.data.title,
      category: entry.data.category,
      summary: entry.data.summary,
      image: media.primary,
      imageAlt: media.primaryAlt,
    },
  ];
});
---

<BaseLayout
  title="Réalisations — Cantrelle Studio"
  description="Études de cas Cantrelle Studio : Sereno, AgencyOS, Belkhir Dépannage — problème, solution, choix techniques et résultat réel."
>
  <PageFilaments client:media="(min-width: 900px)" />

  <!-- Hero full-bleed : pleine largeur, aucun cadre ; le texte reste aligné
       sur la grille du site (.container). -->
  <section class="realisations-hero">
    <div class="container">
      <div class="realisations-hero__inner">
        <span class="realisations-hero__eyebrow">Réalisations</span>
        <h1 class="realisations-hero__title">Des projets conçus pour résoudre un vrai problème.</h1>
        <p class="realisations-hero__lead">
          Trois projets, trois études de cas : le problème posé, la solution construite et l'état réel obtenu.
        </p>
        <p class="realisations-hero__meta">03 études de cas · SaaS · applications métier · sites professionnels</p>
      </div>
    </div>
  </section>

  <div class="realisations-showroom">
  <section class="realisations container">
    <div class="realisations__list">
      {panels.map((panel, index) => (
        <article class:list={["panel", index % 2 === 1 && "panel--reverse"]} data-panel>
          <div class="panel__media">
            <Picture
              src={panel.image}
              alt={panel.imageAlt}
              formats={["avif", "webp"]}
              widths={[480, 768, 1100, 1400]}
              sizes="(min-width: 900px) 55vw, 100vw"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              class="panel__img"
            />
          </div>
          <div class="panel__body">
            <span class="panel__label">Étude de cas</span>
            <h2 class="panel__title">{panel.title}</h2>
            <p class="panel__category">{panel.category}</p>
            <p class="panel__summary">{panel.summary}</p>
            <ul class="panel__chips">
              {panel.chips.map((chip) => <li>{chip}</li>)}
            </ul>
            <a class="panel__cta" href={withBase(`/realisations/${panel.slug}/`)}>
              Découvrir l'étude de cas <span aria-hidden="true">→</span>
              <span class="visually-hidden"> : {panel.title}</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <section class="realisations__cta" aria-labelledby="realisations-cta-title">
      <span class="realisations__eyebrow">Un projet à construire ?</span>
      <h2 id="realisations-cta-title">Votre besoin ne ressemble pas exactement à ces projets ?</h2>
      <p>
        C'est justement le point de départ : comprendre votre contexte, vos contraintes et construire la réponse
        adaptée.
      </p>
      <ActionLink href="/contact/" variant="primary">Parler de votre projet</ActionLink>
    </section>
  </section>
  </div>
</BaseLayout>

<script>
  // Tilt ≤ 2° + halo --px/--py + micro-déplacement du média. Pointeur fin
  // uniquement (jamais au tactile), jamais sous prefers-reduced-motion.
  // Aucune capture du pointeur, aucun blocage du scroll.
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (fine.matches && !reduced.matches) {
    const MAX_TILT_DEG = 2;
    const PANEL_SCALE = 1.005;
    const MEDIA_SCALE = 1.015;
    const MEDIA_SHIFT_PX = 4;
    const PERSPECTIVE_PX = 1400;
    const RETURN_EASE = "cubic-bezier(0.25, 0.46, 0.45, 0.94)";

    document.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
      const media = panel.querySelector<HTMLElement>(".panel__img");
      const isDesktop = () => window.matchMedia("(min-width: 900px)").matches;

      panel.addEventListener("pointermove", (e: PointerEvent) => {
        if (!isDesktop()) return;
        const r = panel.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
        const y = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
        panel.style.transition = "transform 120ms linear";
        panel.style.transform = `perspective(${PERSPECTIVE_PX}px) rotateX(${-y * MAX_TILT_DEG}deg) rotateY(${x * MAX_TILT_DEG}deg) scale(${PANEL_SCALE})`;
        panel.style.setProperty("--px", `${((x + 1) / 2) * 100}%`);
        panel.style.setProperty("--py", `${((y + 1) / 2) * 100}%`);
        if (media) {
          media.style.transition = "transform 260ms ease-out";
          media.style.transform = `translate(${-x * MEDIA_SHIFT_PX}px, ${-y * MEDIA_SHIFT_PX}px) scale(${MEDIA_SCALE})`;
        }
      });

      panel.addEventListener("pointerleave", () => {
        panel.style.transition = `transform 550ms ${RETURN_EASE}`;
        panel.style.transform = "";
        panel.style.setProperty("--px", "50%");
        panel.style.setProperty("--py", "50%");
        if (media) {
          media.style.transition = `transform 700ms ${RETURN_EASE}`;
          media.style.transform = "";
        }
      });
    });
  }
</script>

<style>
  .realisations {
    padding-block: var(--space-xl);
  }

  /* --- Hero full-bleed --------------------------------------------------- */
  .realisations-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
    /* Lumière Ember : même teinte/alpha que .apps-hero-section
       (rgba(228,95,54,0.14)) mais en ellipse à rayon explicite, décentrée à
       gauche et éteinte avant le bord bas : aucune coupure nette. */
    background:
      radial-gradient(ellipse 55% 85% at 28% 40%, rgba(228, 95, 54, 0.18), rgba(228, 95, 54, 0) 70%),
      radial-gradient(ellipse 40% 45% at 86% 45%, rgba(228, 95, 54, 0.06), rgba(228, 95, 54, 0) 70%);
  }

  /* Prolongement d'une trajectoire vers le centre-droit : simple arc CSS
     (bordure haute d'une ellipse) très faible — plus discret que les
     filaments existants (ivoire 0.12) — fondu aux deux extrémités par un
     masque. Visible uniquement sur grand écran ; le texte passe au-dessus. */
  .realisations-hero > .container {
    position: relative;
    z-index: 1;
  }

  .realisations-hero::after {
    content: "";
    display: none;
    position: absolute;
    left: 56%;
    right: 1%;
    top: 54%;
    height: 110px;
    border-top: 1px solid rgba(241, 239, 232, 0.09);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 30%, #000 55%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 30%, #000 55%, transparent 100%);
    pointer-events: none;
  }

  @media (min-width: 1200px) {
    .realisations-hero::after {
      display: block;
    }
  }

  .realisations-hero__inner {
    max-width: 54rem;
  }

  .realisations-hero__eyebrow {
    display: block;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.85;
    margin-bottom: var(--space-md);
  }

  .realisations-hero__title {
    margin: 0 0 var(--space-md) 0;
    max-width: 18ch;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .realisations-hero__lead {
    font-size: 1.1875rem;
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin: 0 0 var(--space-sm) 0;
  }

  .realisations-hero__meta {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  /* --- Transition Hero → showroom ------------------------------------------
     Fond pleine largeur qui passe de transparent (filaments/Ember encore
     visibles) à l'aplat graphite : sortie progressive, pas de bordure. */
  .realisations-showroom {
    padding-top: clamp(1rem, 3vw, 2.5rem);
    background: linear-gradient(to bottom, rgba(10, 11, 13, 0), var(--color-bg) 9rem);
  }

  /* --- Panneaux --------------------------------------------------------- */
  .realisations__list {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .panel {
    --px: 50%;
    --py: 50%;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1rem, 2.5vw, 2rem);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    /* Anneau Ember très discret (même langage que le Hero Applications,
       alpha fortement réduit) + profondeur légère. */
    box-shadow:
      0 18px 40px -30px rgba(0, 0, 0, 0.7),
      0 0 0 1px var(--color-border);
    transition: box-shadow 450ms ease;
    will-change: transform;
  }

  /* Halo radial piloté par --px/--py : contenu dans le panneau, derrière le
     texte (z-index négatif dans le contexte `isolation`). */
  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--px) var(--py), rgba(228, 95, 54, 0.1), rgba(228, 95, 54, 0) 60%);
    opacity: 0;
    transition: opacity 450ms ease;
    pointer-events: none;
    z-index: -1;
  }

  /* Liseré Ember sur ~22 % du bord haut (langage des cartes Home). */
  .panel::after {
    content: "";
    position: absolute;
    top: 0;
    left: clamp(1.5rem, 4vw, 3rem);
    width: 22%;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), rgba(228, 95, 54, 0));
    opacity: 0.35;
    transition: opacity 450ms ease;
    pointer-events: none;
  }

  .panel:hover,
  .panel:focus-within {
    box-shadow:
      0 22px 48px -28px rgba(228, 95, 54, 0.28),
      0 0 0 1px rgba(228, 95, 54, 0.2);
  }

  .panel:hover::before,
  .panel:focus-within::before {
    opacity: 1;
  }

  .panel:hover::after,
  .panel:focus-within::after {
    opacity: 1;
  }

  /* Média : fenêtre encadrée sur le projet. Ratio de la source (≈ 2:1),
     jamais de recadrage fort. */
  .panel__media {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-soft);
    overflow: hidden;
    aspect-ratio: 1920 / 955;
  }

  .panel__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    will-change: transform;
  }

  .panel__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-xs) clamp(0rem, 1vw, 0.75rem);
  }

  .panel__label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .panel__title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .panel__category {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-accent);
    opacity: 0.85;
  }

  .panel__summary {
    margin: var(--space-xs) 0 0 0;
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 44ch;
  }

  .panel__chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--space-xs) 0 0 0;
    padding: 0;
  }

  .panel__chips li {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    margin-top: var(--space-sm);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-strong);
    transition: border-color 250ms ease, color 250ms ease;
  }

  .panel__cta:hover {
    border-color: var(--color-accent);
  }

  .panel__cta:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Desktop : 55 % média / 45 % contenu, alternance. */
  @media (min-width: 900px) {
    .panel {
      grid-template-columns: 55fr 45fr;
      align-items: center;
    }

    .panel--reverse {
      grid-template-columns: 45fr 55fr;
    }

    .panel--reverse .panel__media {
      order: 2;
    }
  }

  /* --- CTA final -------------------------------------------------------- */
  .realisations__eyebrow {
    display: block;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.85;
    margin-bottom: var(--space-sm);
  }

  .realisations__cta {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: radial-gradient(circle at 50% 0%, rgba(228, 95, 54, 0.1), rgba(228, 95, 54, 0) 65%), var(--color-surface);
    text-align: center;
  }

  .realisations__cta h2 {
    margin: 0 auto var(--space-sm) auto;
    max-width: 28ch;
  }

  .realisations__cta p {
    margin: 0 auto var(--space-md) auto;
    max-width: 48ch;
    color: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .panel::before,
    .panel::after,
    .panel__cta {
      transition: none;
    }

    .panel,
    .panel__img {
      transform: none !important;
    }
  }
</style>
