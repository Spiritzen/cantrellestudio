---
// Étude de cas premium — CS-S10. Remplace le rendu générique CS-S0
// (H1 nu + Problème/Solution/Résultat en paragraphes plats) par une vraie
// narration : problème → réflexion → solution → démonstration visuelle →
// choix techniques → résultat réel → ce que ça démontre → projet suivant.
// Structure commune (prompt §11), composition centrale différenciée par
// projet (prompt §33) : Sereno = timeline de workflow (structure/
// conformité), AgencyOS = grille de modules (système/produit), Belkhir =
// blocs éditoriaux alternés (contenu/conversion).
//
// Narration et faits enrichis dans src/data/caseStudyContent.ts (voir ce
// fichier pour l'arbitrage sur la Content Collection, non modifiée dans
// sa structure). Médias réels dans src/data/projectMedia.ts (`gallery`).
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ActionLink from "../../components/ui/ActionLink.astro";
import ServiceBreadcrumb from "../../components/services/ServiceBreadcrumb.astro";
import ServiceMotion from "../../components/services/ServiceMotion.astro";
import CaseStudyHero from "../../components/case-studies/CaseStudyHero.astro";
import CaseStudySection from "../../components/case-studies/CaseStudySection.astro";
import CaseStudyMedia from "../../components/case-studies/CaseStudyMedia.astro";
import CaseStudyTech from "../../components/case-studies/CaseStudyTech.astro";
import CaseStudyOutcome from "../../components/case-studies/CaseStudyOutcome.astro";
import CaseStudyNext from "../../components/case-studies/CaseStudyNext.astro";
import RelatedService from "../../components/relations/RelatedService.astro";
import { projectMedia } from "../../data/projectMedia";
import { caseStudyContent, nextProjectSlug } from "../../data/caseStudyContent";
import { getServicesForProject } from "../../data/serviceCaseStudyMap";
import { withBase } from "../../utils/paths";
// Belkhir uniquement — section « Expérience mobile » : capture haute définition
// déjà présente dans le dépôt (non utilisée ailleurs), servie via astro:assets.
import { Picture, getImage } from "astro:assets";
import ImageLightbox from "../../components/ui/ImageLightbox.astro";
import belkhirMobileScreen from "../../assets/projects/belkhir-depannage/belkhir-mobile1.jpg";
// Sereno uniquement (S1 fondations DA) : UNE occurrence du champ de points, dans
// « Problème / Réflexion », composant existant réutilisé tel quel.
import ExpertiseDotWave from "../../components/motion/ExpertiseDotWave.astro";
// Sereno uniquement (S1B) : filaments animés existants (Three.js, fixed z-index:-1,
// hydratés >= 900 px), montés TELS QUELS ; seul le Hero est transparent (CSS Sereno),
// les sections suivantes sont opaques et les recouvrent.
import PageFilaments from "../../components/hero/PageFilaments";
import "../../styles/case-study.css";

export const getStaticPaths = (async () => {
  const realisations = await getCollection("realisations");
  return realisations.map((realisation) => ({
    params: { slug: realisation.data.slug },
    props: { realisation, allRealisations: realisations },
  }));
}) satisfies GetStaticPaths;

const { realisation, allRealisations } = Astro.props;
const { slug, title, seoTitle, seoDescription } = realisation.data;

const content = caseStudyContent[slug];
const media = projectMedia[slug];
const nextSlug = nextProjectSlug[slug];
const nextRealisation = allRealisations.find((r) => r.data.slug === nextSlug);

// CS-S10B — Service(s) associé(s) à ce projet, source unique
// `serviceCaseStudyMap.ts` (remplace les constantes locales `serviceHref`/
// `serviceLabel` de CS-S10, qui dupliquaient cette relation). `principal`
// est toujours présent pour les 3 projets ; `connexe` uniquement pour
// AgencyOS (prompt §11).
const relatedServices = getServicesForProject(slug);
const principalService = relatedServices.find((s) => s.onProjectPage === "principal")!;
const connexeService = relatedServices.find((s) => s.onProjectPage === "connexe");

// Sous-titres de la démonstration visuelle, adaptés par projet (prompt
// §14-21) : Sereno suit le workflow de la facture, AgencyOS les modules
// produit, Belkhir les moments éditoriaux du parcours visiteur.
const workflowSteps = [
  { title: "Créer", text: "Un brouillon prend forme, ligne par ligne, avec calcul serveur des totaux et de la TVA." },
  { title: "Contrôler", text: "Le moteur de conformité bloque l'émission tant qu'une erreur reste détectée." },
  { title: "Émettre", text: "La facture devient immuable : numéro attribué, PDF/A-3 et XML générés." },
  { title: "Suivre", text: "Transmission simulée (sandbox), statuts et solde de paiement suivis dans le temps." },
  { title: "Corriger", text: "Une erreur après émission se corrige par un avoir conforme, jamais par une réécriture." },
];

const moduleGroups = [
  { title: "Dashboard", text: "Indicateurs temps réel : chiffre d'affaires, projets actifs, tâches, factures impayées." },
  { title: "CRM", text: "Clients, contacts et pipeline, centralisés et à jour." },
  { title: "Projets & tâches", text: "Kanban, phases, progression automatique par projet." },
  { title: "Timesheet", text: "Saisie des heures, rentabilité par projet." },
  { title: "Finance", text: "Devis, factures, paiements et dépenses dans le même espace." },
  { title: "Équipe", text: "Rôles, invitations et portail collaboratif." },
];

// Titres courts des blocs éditoriaux Belkhir, alignés sur l'ordre de la
// galerie (accueil → qualification → métier → zone → mobile).
const belkhirRowTitles = ["Accueil", "Qualifier l'urgence", "Une page par métier", "Vérifier sa zone", "Pensé mobile"];

// AgencyOS : micro-labels de couche, dans l ordre de content.tech (backend, interface, données, sécurité, infra).
// Rendus en CSS (data-layer) : le dl garde exactement ses dt / dd.
const belkhirLayers = ["Structure", "Fiabilité", "Performance", "Direction visuelle"];
const aosLayers = ["Backend", "Interface", "Données", "Sécurité", "Infrastructure"];

// S-lightbox — Sereno et AgencyOS : source haute définition (largeur d origine, 1920 px)
// pour chaque capture, générée au build ; chargée seulement à l ouverture de la modale.
const serenoLightbox =
  slug === "sereno" || slug === "agencyos"
    ? await Promise.all(
        media.gallery!.map(async (g) => ({
          full: (await getImage({ src: g.image, width: 1920, format: "webp", quality: 85 })).src,
          alt: g.alt,
          caption: g.caption,
        })),
      )
    : [];

// CS-S12B — OG dédié (prompt §9) : source unique `projectMedia.ts`
// (`ogImage`/`ogImageAlt`, déjà la source de vérité média du projet,
// aucune deuxième source créée). Fallback vers le visuel global si absent
// (ne devrait pas arriver, les 3 projets sont renseignés).
const ogImage = media.ogImage;
const ogImageAlt = media.ogImageAlt;

// CS-S12B — structured data `CreativeWork` (prompt §10) : name/description/
// url/image directement repris du contenu déjà public de la page (aucune
// donnée inventée, aucun `creator`/`dateCreated` non confirmé). `description`
// réutilise `seoDescription` (déjà la meta description de cette page) pour
// ne jamais diverger d'elle.
const creativeWorkSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: seoDescription,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  image: new URL(withBase(ogImage ?? "/og/cantrelle-studio-og.png"), Astro.site).toString(),
};
---

<BaseLayout title={seoTitle} description={seoDescription} image={ogImage} imageAlt={ogImageAlt}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(creativeWorkSchema)} />
  {(slug === "sereno" || slug === "agencyos" || slug === "belkhir-depannage") && <PageFilaments client:media="(min-width: 900px)" />}
  <div class:list={["case-study", `case-study--${slug === "belkhir-depannage" ? "belkhir" : slug}`]}>
    <div class="container">
      <ServiceBreadcrumb current={title} />
    </div>

    <CaseStudySection>
      <CaseStudyHero
        eyebrow={content.eyebrow}
        title={title}
        summary={content.heroSummary}
        statusLabel={content.statusLabel}
        stack={content.stackShort}
        image={media.gallery![0].image}
        imageAlt={media.gallery![0].alt}
        liveUrl={slug === "belkhir-depannage" ? "https://spiritzen.github.io/belkhir-depannage/" : undefined}
      />
      <RelatedService
        role="principal"
        serviceLabel={principalService.serviceLabel}
        serviceHref={principalService.serviceHref}
        angle={principalService.angle}
      />
      {connexeService && (
        <RelatedService role="connexe" serviceLabel={connexeService.serviceLabel} serviceHref={connexeService.serviceHref} />
      )}
    </CaseStudySection>

    <CaseStudySection soft aria-labelledby="problem-title" class={slug === "sereno" ? "cs-sereno-problem" : slug === "agencyos" || slug === "belkhir-depannage" ? "cs-aos-problem" : undefined}>
      {(slug === "sereno" || slug === "agencyos" || slug === "belkhir-depannage") && <ExpertiseDotWave />}
      <div class="case-study__problem-reflection">
        <div class="case-study__problem" data-motion="block">
          {slug === "sereno" && <span class="cs-sereno-index" aria-hidden="true">01</span>}
          {(slug === "agencyos" || slug === "belkhir-depannage") && <span class="cs-aos-index" aria-hidden="true">01</span>}
          <span class="case-study__eyebrow">Le problème</span>
          <h2 id="problem-title">{content.problemTitle}</h2>
          {content.problemBody.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {slug === "sereno" && <div class="cs-sereno-divider" data-motion="block" aria-hidden="true"></div>}
        {(slug === "agencyos" || slug === "belkhir-depannage") && <div class="cs-aos-divider" data-motion="block" aria-hidden="true"></div>}
        <div class="case-study__reflection" data-motion="block">
          {slug === "sereno" && <span class="cs-sereno-index" aria-hidden="true">02</span>}
          {(slug === "agencyos" || slug === "belkhir-depannage") && <span class="cs-aos-index" aria-hidden="true">02</span>}
          <span class="case-study__eyebrow">La réflexion</span>
          <blockquote>{content.reflectionQuote}</blockquote>
          {content.reflectionBody && <p>{content.reflectionBody}</p>}
        </div>
      </div>
    </CaseStudySection>

    {slug === "sereno" && (
      <CaseStudySection aria-labelledby="solution-title" class="cs-sereno-solution">
        <span class="case-study__eyebrow">La solution</span>
        <h2 id="solution-title">Le parcours d'une facture</h2>
        {/* S3B : pas de data-motion ici — la séquence 01 → 05 est pilotée par is-armed / is-in (script plus bas). */}
        <div class="case-study__workflow">
          {workflowSteps.map((step, i) => (
            <div class="case-study__workflow-step">
              <span class="cs-step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))}
        </div>
      </CaseStudySection>
    )}

    {slug === "agencyos" && (
      <CaseStudySection aria-labelledby="solution-title" class="cs-aos-solution">
        <span class="case-study__eyebrow">La solution</span>
        <h2 id="solution-title">Un même produit, plusieurs domaines métier</h2>
        {/* Reveal en 2 vagues piloté par is-armed / is-in (script plus bas) ; repères 01-06 purement éditoriaux. */}
        <div class="case-study__modules">
          {moduleGroups.map((group, i) => (
            <div class="case-study__module">
              <span class="cs-aos-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3>{group.title}</h3>
              <p>{group.text}</p>
            </div>
          ))}
        </div>
      </CaseStudySection>
    )}

    <CaseStudySection
      soft={slug !== "sereno" && slug !== "agencyos"}
      aria-labelledby="demo-title"
      class={slug === "sereno" ? "cs-sereno-demo" : slug === "agencyos" ? "cs-aos-demo" : undefined}
    >
      {/* S4 : même champ de points que « Expertises » de la landing (composant réutilisé tel quel). */}
      {(slug === "sereno" || slug === "agencyos") && <ExpertiseDotWave />}
      <span class="case-study__eyebrow">Démonstration visuelle</span>
      <h2 id="demo-title">
        {slug === "belkhir-depannage" ? "De l'accueil à la prise de contact" : "Ce qui a été construit"}
      </h2>

      {slug === "belkhir-depannage" ? (
        <div class="bk-panels">
          {/* 4 preuves desktop (la 5e capture, mobile, a sa propre section plus bas).
              Wrapper data-motion = révélation générique ; le panneau intérieur
              porte seul le hover (pas de conflit de transform). */}
          {media.gallery!.slice(0, 4).map((item, i) => (
            <div data-motion="block">
              <article
                class:list={["bk-panel", i % 2 === 1 && "bk-panel--reverse"]}
                data-bk-panel
                style={`--bk-ratio: ${item.image.width} / ${item.image.height}`}
              >
                <div class="bk-panel__media">
                  <CaseStudyMedia image={item.image} alt={item.alt} eager={i === 0} />
                </div>
                <div class="bk-panel__body">
                  <span class="bk-panel__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <span class="bk-panel__label">Décision</span>
                  <h3>{belkhirRowTitles[i] ?? item.caption}</h3>
                  <span class="bk-panel__label bk-panel__label--proof">À l'écran</span>
                  <p>{item.caption}</p>
                </div>
              </article>
            </div>
          ))}
        </div>
      ) : (
        <div class:list={["case-study__gallery", media.gallery!.length > 4 && "case-study__gallery--3col"]}>
          {media.gallery!.map((item, i) => (
            <div data-motion="block" class={slug === "sereno" || slug === "agencyos" ? "cs-sereno-zoomable" : undefined}>
              <CaseStudyMedia image={item.image} alt={item.alt} caption={item.caption} index={i + 1} />
              {(slug === "sereno" || slug === "agencyos") && (
                <button
                  type="button"
                  class="cs-sereno-zoom"
                  data-lightbox-trigger={`${slug}-gallery`}
                  data-full={serenoLightbox[i].full}
                  data-alt={serenoLightbox[i].alt}
                  data-caption={serenoLightbox[i].caption}
                  aria-label={`Agrandir la capture ${i + 1} sur ${media.gallery!.length}`}
                ></button>
              )}
            </div>
          ))}
        </div>
      )}
    </CaseStudySection>

    {slug === "belkhir-depannage" && (
      <CaseStudySection class="bk-mobile" aria-labelledby="mobile-title">
        <div class="bk-mobile__layout" data-bk-mobile>
          <div class="bk-mobile__stage">
            <div class="bk-phone-wrap">
              <div class="bk-phone">
                <span class="bk-phone__btn bk-phone__btn--left" aria-hidden="true"></span>
                <span class="bk-phone__btn bk-phone__btn--right" aria-hidden="true"></span>
                <div class="bk-phone__screen">
                  <Picture
                    src={belkhirMobileScreen}
                    alt={media.gallery![4].alt}
                    formats={["avif", "webp"]}
                    widths={[300, 480, 640]}
                    sizes="(min-width: 900px) 310px, 250px"
                    loading="lazy"
                    decoding="async"
                    class="bk-phone__img"
                  />
                  <span class="bk-phone__island" aria-hidden="true"></span>
                  <span class="bk-phone__glare" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          </div>
          <div class="bk-mobile__text">
            <span class="bk-mobile__label">Expérience mobile</span>
            <h2 id="mobile-title">
              Pensé pour l'urgence.<br />Pensé pour le <span class="bk-accent">mobile</span>.
            </h2>
            <p>La barre d'appel reste accessible en permanence, sur l'écran le plus utilisé en urgence.</p>
            <ul class="bk-mobile__chips">
              <li>Barre d'appel permanente</li>
              <li>Navigation mobile accessible</li>
              <li>Appel et devis toujours visibles</li>
            </ul>
          </div>
        </div>
      </CaseStudySection>
    )}

    <CaseStudySection soft={slug === "sereno" || slug === "agencyos" || slug === "belkhir-depannage"} aria-labelledby="tech-title" class={slug === "belkhir-depannage" ? "cs-bk-tech-section" : undefined}>
      {slug === "belkhir-depannage" && <ExpertiseDotWave />}
      <span class="case-study__eyebrow">Choix techniques</span>
      <h2 id="tech-title">La technologie, et pourquoi elle est là</h2>
      {slug === "sereno" ? (
        <dl class="case-study__tech cs-sereno-tech">
          {content.tech.map((item) => (
            <div class="case-study__tech-row" data-motion="block">
              <dt>{item.name}</dt>
              <dd>{item.role}</dd>
            </div>
          ))}
        </dl>
      ) : slug === "agencyos" || slug === "belkhir-depannage" ? (
        <dl class="case-study__tech cs-aos-tech">
          {content.tech.map((item, i) => (
            <div class="case-study__tech-row" data-layer={(slug === "agencyos" ? aosLayers : belkhirLayers)[i]}>
              <dt>{item.name}</dt>
              <dd>{item.role}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <div data-motion="block">
          <CaseStudyTech items={content.tech} />
        </div>
      )}
      {content.githubUrl && (
        <p class={slug === "sereno" ? "cs-sereno-github" : slug === "belkhir-depannage" ? "cs-bk-github" : undefined}>
          <a class="case-study__github" href={content.githubUrl} target="_blank" rel="noopener noreferrer">
            {content.githubLabel} <span aria-hidden="true">↗</span>
          </a>
        </p>
      )}
    </CaseStudySection>

    <CaseStudySection aria-labelledby="outcome-title" class={slug === "sereno" ? "cs-sereno-demo" : slug === "agencyos" ? "cs-aos-demo cs-aos-outcome-section" : undefined}>
      {/* S6 : même fond que « Démonstration visuelle » (classe et champ de points réutilisés). */}
      {(slug === "sereno" || slug === "agencyos") && <ExpertiseDotWave />}
      <span class="case-study__eyebrow">Résultat réel</span>
      <h2 id="outcome-title">{slug === "sereno" ? "Un socle fonctionnel, validé avant exploitation commerciale." : slug === "agencyos" ? "Un socle SaaS multi-tenant déjà opérationnel." : "Ce qui a été construit"}</h2>
      {slug === "sereno" || slug === "agencyos" ? (
        <div class="cs-sereno-outcome">
          <div class="cs-sereno-outcome__grid">
            <div class="cs-sereno-outcome__done">
              <h3 data-motion="block">Construit et validé</h3>
              <ul class="cs-proof-rails">
                {content.outcomeAchieved.map((item) => (
                  <li data-motion="block">
                    <span class="cs-proof-text">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="cs-sereno-outcome__divider" data-motion="block" aria-hidden="true"></div>
            <div class="cs-sereno-outcome__next" data-motion="block">
              <h3>Avant une exploitation commerciale</h3>
              <ul class="cs-todo-list">
                {content.outcomeNext.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
          <div class="cs-sereno-outcome__proves" data-motion="block">
            <p class="cs-sereno-outcome__label">Ce que ce projet démontre</p>
            <ul class="cs-proves-list">
              {content.proves.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <div data-motion="block">
          <CaseStudyOutcome achieved={content.outcomeAchieved} next={content.outcomeNext} proves={content.proves} />
        </div>
      )}
    </CaseStudySection>

    <CaseStudySection soft aria-labelledby="cta-title" class={slug === "sereno" ? "cs-sereno-final" : slug === "agencyos" || slug === "belkhir-depannage" ? "cs-aos-final" : undefined}>
      <div class="case-study__cta" data-motion="block">
        <span class="case-study__eyebrow">Vous avez un besoin similaire ?</span>
        <h2 id="cta-title">Parlons de votre projet.</h2>
        <div class="case-study__cta-actions">
          <ActionLink href="/contact/" variant="primary">Parler de votre projet</ActionLink>
          <ActionLink href={principalService.serviceHref} variant="secondary">
            Découvrir {principalService.serviceLabel}
          </ActionLink>
        </div>
      </div>

      {nextRealisation && (
        <div class="case-study__next-wrapper" data-motion="block">
          <CaseStudyNext
            title={nextRealisation.data.shortTitle ?? nextRealisation.data.title}
            category={nextRealisation.data.category}
            href={`/realisations/${nextRealisation.data.slug}/`}
          />
        </div>
      )}

      <p><a href={withBase("/realisations/")}>← Toutes les réalisations</a></p>
    </CaseStudySection>
  </div>

  {slug === "sereno" && <ImageLightbox id="sereno-gallery" mode="gallery" title={title} />}
  {slug === "agencyos" && <ImageLightbox id="agencyos-gallery" mode="gallery" title={title} />}

  <ServiceMotion />
</BaseLayout>

<script>
  // Belkhir uniquement (no-op sur Sereno / AgencyOS : aucun de ces éléments n'existe).
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktop = window.matchMedia("(min-width: 900px)");

  // 1) Section mobile : entrée du téléphone depuis la gauche, UNE SEULE FOIS.
  const mobile = document.querySelector<HTMLElement>(".bk-mobile");
  if (mobile && desktop.matches && !reduced.matches && "IntersectionObserver" in window) {
    mobile.classList.add("bk-mobile--armed");
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          mobile.classList.add("bk-mobile--in");
          io.disconnect();
        }
      },
      { threshold: 0.33 },
    );
    io.observe(mobile);
  }

  // 2) Panneaux de preuve : langage de /realisations/ (halo --px/--py, tilt ≤ 1.5°,
  // micro-scale du média), pointeur fin uniquement, jamais en reduced-motion.
  if (finePointer.matches && !reduced.matches) {
    const MAX_TILT_DEG = 1.5;
    const PANEL_SCALE = 1.005;
    const MEDIA_SCALE = 1.015;
    const MEDIA_SHIFT_PX = 3;
    const RETURN_EASE = "cubic-bezier(0.25, 0.46, 0.45, 0.94)";

    document.querySelectorAll<HTMLElement>("[data-bk-panel]").forEach((panel) => {
      const media = panel.querySelector<HTMLElement>(".case-study__media-img");
      panel.addEventListener("pointermove", (e: PointerEvent) => {
        if (!desktop.matches) return;
        const r = panel.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
        const y = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
        panel.style.transition = "transform 120ms linear";
        panel.style.transform = `perspective(1400px) rotateX(${-y * MAX_TILT_DEG}deg) rotateY(${x * MAX_TILT_DEG}deg) scale(${PANEL_SCALE})`;
        panel.style.setProperty("--px", `${((x + 1) / 2) * 100}%`);
        panel.style.setProperty("--py", `${((y + 1) / 2) * 100}%`);
        if (media) {
          media.style.transition = "transform 260ms ease-out";
          media.style.transform = `translate(${-x * MEDIA_SHIFT_PX}px, ${-y * MEDIA_SHIFT_PX}px) scale(${MEDIA_SCALE})`;
        }
      });
      panel.addEventListener("pointerleave", () => {
        panel.style.transition = `transform 550ms ${RETURN_EASE}`;
        panel.style.transform = "";
        panel.style.setProperty("--px", "50%");
        panel.style.setProperty("--py", "50%");
        if (media) {
          media.style.transition = `transform 700ms ${RETURN_EASE}`;
          media.style.transform = "";
        }
      });
    });
  }

  // 5) « La solution » Sereno : séquence 01 → 05 + progression Ember le long du rail.
  // Même logique d'hystérésis que /contact/ (entrée à 33 % visible, réarmement sous 7 %) ;
  // non armée sous reduced-motion (tout reste visible, état final).
  const solution = document.querySelector<HTMLElement>(".cs-sereno-solution");
  if (solution && !reduced.matches && "IntersectionObserver" in window) {
    solution.classList.add("is-armed");
    new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.intersectionRatio >= 0.33) solution.classList.add("is-in");
          else if (e.intersectionRatio < 0.07) solution.classList.remove("is-in");
        });
      },
      { threshold: [0, 0.03, 0.07, 0.15, 0.25, 0.33, 0.5] },
    ).observe(solution);
  }

  // 5b) « La solution » AgencyOS : reveal des 6 domaines en 2 vagues (mêmes seuils d'hystérésis ;
  // non armé sous reduced-motion : tout reste visible). Les domaines sont parallèles, pas séquentiels.
  const aosModules = document.querySelector<HTMLElement>(".case-study--agencyos .case-study__modules");
  if (aosModules && !reduced.matches && "IntersectionObserver" in window) {
    aosModules.classList.add("is-armed");
    new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.intersectionRatio >= 0.3) aosModules.classList.add("is-in");
          else if (e.intersectionRatio < 0.05) aosModules.classList.remove("is-in");
        });
      },
      { threshold: [0, 0.05, 0.15, 0.3, 0.5] },
    ).observe(aosModules);
  }

  // 5c) « Choix techniques » AgencyOS : reveal des 5 couches (colonne, points, rails). Mêmes seuils
  // d'hystérésis ; non armé sous reduced-motion. Briques d'architecture, pas des étapes.
  const aosTech = document.querySelector<HTMLElement>(".case-study--agencyos .cs-aos-tech, .case-study--belkhir .cs-aos-tech");
  if (aosTech && !reduced.matches && "IntersectionObserver" in window) {
    aosTech.classList.add("is-armed");
    new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.intersectionRatio >= 0.3) aosTech.classList.add("is-in");
          else if (e.intersectionRatio < 0.05) aosTech.classList.remove("is-in");
        });
      },
      { threshold: [0, 0.05, 0.15, 0.3, 0.5] },
    ).observe(aosTech);
  }

  // 4b) Média du Hero AgencyOS : HeliFan un cran plus sobre que Sereno (rotateX <= 1,5°,
  // rotateY <= 2°, translateY -1 px, scale 1.003, perspective 1700 px, retour 600 ms).
  // Pointeur fin, >= 900 px, jamais en reduced-motion ; aucune dimension modifiée.
  const aosMedia = document.querySelector<HTMLElement>(".case-study--agencyos .case-study__hero-media");
  if (aosMedia && finePointer.matches && !reduced.matches) {
    const A_EASE = "cubic-bezier(0.25, 0.46, 0.45, 0.94)";
    aosMedia.addEventListener("pointermove", (e: PointerEvent) => {
      if (!desktop.matches) return;
      const r = aosMedia.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
      const y = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
      aosMedia.classList.add("is-active");
      aosMedia.style.transition = "transform 120ms linear, box-shadow 450ms ease";
      aosMedia.style.transform = `perspective(1700px) rotateX(${(-y * 1.5).toFixed(2)}deg) rotateY(${(x * 2).toFixed(2)}deg) translateY(-1px) scale(1.003)`;
      aosMedia.style.setProperty("--mx", `${((x + 1) / 2) * 100}%`);
      aosMedia.style.setProperty("--my", `${((y + 1) / 2) * 100}%`);
    });
    aosMedia.addEventListener("pointerleave", () => {
      aosMedia.classList.remove("is-active");
      aosMedia.style.transition = `transform 600ms ${A_EASE}, box-shadow 600ms ease`;
      aosMedia.style.transform = "";
      aosMedia.style.setProperty("--mx", "50%");
      aosMedia.style.setProperty("--my", "50%");
    });
  }

  // 4) Média du Hero Sereno : même langage que le Hero de /applications-metier-saas/
  // (tilt piloté par le pointeur, halo --mx/--my, retour doux) mais très atténué :
  // rotateX <= 2°, rotateY <= 2.5°, translateY -2 px, scale 1.005, perspective 1600 px.
  // Pointeur fin, >= 900 px, jamais en reduced-motion. Aucune taille modifiée.
  const serenoMedia = document.querySelector<HTMLElement>(".case-study--sereno .case-study__hero-media");
  const serenoWide = window.matchMedia("(min-width: 900px)");
  if (serenoMedia && finePointer.matches && !reduced.matches) {
    const S_RETURN_EASE = "cubic-bezier(0.25, 0.46, 0.45, 0.94)";

    serenoMedia.addEventListener("pointermove", (e: PointerEvent) => {
      if (!serenoWide.matches) return;
      const r = serenoMedia.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
      const y = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
      serenoMedia.classList.add("is-active");
      serenoMedia.style.transition = "transform 120ms linear, box-shadow 450ms ease";
      serenoMedia.style.transform = `perspective(1600px) rotateX(${(-y * 2).toFixed(2)}deg) rotateY(${(x * 2.5).toFixed(2)}deg) translateY(-2px) scale(1.005)`;
      serenoMedia.style.setProperty("--mx", `${((x + 1) / 2) * 100}%`);
      serenoMedia.style.setProperty("--my", `${((y + 1) / 2) * 100}%`);
    });

    serenoMedia.addEventListener("pointerleave", () => {
      serenoMedia.classList.remove("is-active");
      serenoMedia.style.transition = `transform 600ms ${S_RETURN_EASE}, box-shadow 600ms ease`;
      serenoMedia.style.transform = "";
      serenoMedia.style.setProperty("--mx", "50%");
      serenoMedia.style.setProperty("--my", "50%");
    });
  }

  // 3) Média du Hero Belkhir : « objet premium » (tilt + parallaxe interne +
  // reflet + contour). Pointeur fin, ≥ 960 px, jamais en reduced-motion.
  // Retour au repos doux au pointerleave. Aucune capture du pointeur.
  const heroMedia = document.querySelector<HTMLElement>(".case-study--belkhir .case-study__hero-media");
  const heroImg = heroMedia?.querySelector<HTMLElement>(".case-study__hero-img");
  const heroWide = window.matchMedia("(min-width: 960px)");
  if (heroMedia && heroImg && finePointer.matches && !reduced.matches) {
    const REST_ROTATE_Y = -1.2; // inclinaison de repos du Hero (CSS)
    const MAX_ROTATE_Y = 5;
    const MAX_ROTATE_X = 3.5;
    const SCALE = 1.012;
    const IMG_SHIFT_X = 7; // px, sens opposé au tilt
    const IMG_SHIFT_Y = 5;
    const IMG_SCALE = 1.035; // marge pour que le parallaxe ne révèle jamais un bord
    const RETURN_EASE = "cubic-bezier(0.25, 0.46, 0.45, 0.94)";

    heroMedia.addEventListener("pointermove", (e: PointerEvent) => {
      if (!heroWide.matches) return;
      const r = heroMedia.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
      const y = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
      heroMedia.classList.add("is-active");
      heroMedia.style.transition = "transform 120ms linear, box-shadow 450ms ease, border-color 450ms ease";
      heroMedia.style.transform = `perspective(1800px) rotateX(${(-y * MAX_ROTATE_X).toFixed(2)}deg) rotateY(${(REST_ROTATE_Y + x * MAX_ROTATE_Y).toFixed(2)}deg) scale(${SCALE})`;
      heroMedia.style.setProperty("--mx", `${((x + 1) / 2) * 100}%`);
      heroMedia.style.setProperty("--my", `${((y + 1) / 2) * 100}%`);
      heroMedia.style.setProperty("--gx", x.toFixed(3));
      heroMedia.style.setProperty("--gy", y.toFixed(3));
      heroImg.style.transition = "transform 260ms ease-out";
      heroImg.style.transform = `translate(${(-x * IMG_SHIFT_X).toFixed(2)}px, ${(-y * IMG_SHIFT_Y).toFixed(2)}px) scale(${IMG_SCALE})`;
    });

    heroMedia.addEventListener("pointerleave", () => {
      heroMedia.classList.remove("is-active");
      heroMedia.style.transition = `transform 600ms ${RETURN_EASE}, box-shadow 600ms ease, border-color 600ms ease`;
      heroMedia.style.transform = ""; // retombe sur l'état de repos CSS
      heroMedia.style.setProperty("--mx", "50%");
      heroMedia.style.setProperty("--my", "50%");
      heroMedia.style.setProperty("--gx", "0");
      heroMedia.style.setProperty("--gy", "0");
      heroImg.style.transition = `transform 650ms ${RETURN_EASE}`;
      heroImg.style.transform = "";
    });
  }
</script>

