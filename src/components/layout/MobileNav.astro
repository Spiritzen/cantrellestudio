---
// MobileNav — menu mobile accessible (CS-S4 §17/§18/§19).
// Composant autonome : bouton hamburger + panneau + petit script vanilla
// local. Aucun React, aucune bibliothèque, aucun focus trap complexe :
// le focus est déplacé à l'ouverture/fermeture mais pas piégé (le panneau
// n'est pas un modal plein écran au sens ARIA — voir prompt §18).
import ActionLink from "../ui/ActionLink.astro";
// Micro-sprint pré-déploiement GitHub Pages — `currentPath` reçu de Header
// est déjà normalisé (base-stripped) là-bas ; ici on n'a besoin que de
// `withBase()` pour le rendu des `href` (comparaison `isActive` inchangée,
// sur les chemins canoniques non préfixés).
import { withBase } from "../../utils/paths";

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  services: NavItem[];
  mainLinks: NavItem[];
  currentPath: string;
}

const { services, mainLinks, currentPath } = Astro.props;

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href);
}
---

<div class="mobile-nav">
  <button
    type="button"
    class="mobile-nav__toggle"
    id="mobile-nav-toggle"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
  >
    <span class="mobile-nav__sr-only">Ouvrir le menu</span>
    <span class="mobile-nav__burger" aria-hidden="true"></span>
  </button>

  <div class="mobile-nav__backdrop" id="mobile-nav-backdrop" hidden></div>

  <div class="mobile-nav__panel" id="mobile-nav-panel" hidden>
    <nav aria-label="Navigation principale (mobile)">
      <p class="mobile-nav__group-title">Services</p>
      <ul class="mobile-nav__list">
        {services.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <ul class="mobile-nav__list mobile-nav__list--main">
        {mainLinks.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <ActionLink href="/contact/" variant="primary" class="mobile-nav__cta">
        Parler du projet
      </ActionLink>
    </nav>
  </div>
</div>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const backdrop = document.getElementById("mobile-nav-backdrop");
  const panel = document.getElementById("mobile-nav-panel");
  const header = toggle?.closest("header");

  if (toggle && backdrop && panel && header) {
    // Micro-sprint correctif "Header / menu mobile" (PROMPT_CLAUDE_CODE_
    // CORRECTIF_HEADER_MENU_MOBILE_POST_AUDIT, cause #2 démontrée par
    // l'audit) — `backdrop`/`panel` étaient des descendants DOM de
    // `<header>`, dont `backdrop-filter` (Header.astro) crée un bloc
    // englobant pour leurs `position:fixed` : mesuré à ~72-88px de haut
    // au lieu du viewport entier. Portail DOM, UNE SEULE FOIS au montage
    // (jamais dans openMenu/closeMenu — éviterait duplication/écouteurs
    // multiples), même technique que les modales déjà validées du site
    // (CustomStartingPoint/CustomUseCases/CustomProofs) : les références
    // `backdrop`/`panel` restent valables après `appendChild` (déplace le
    // nœud existant, ne le recrée pas), le CSS scopé Astro continue de
    // s'appliquer (basé sur l'attribut `data-astro-cid-*` déjà posé sur
    // ces éléments, pas sur leur position dans le DOM). Le bouton
    // hamburger (`toggle`), lui, RESTE dans le Header.
    document.body.appendChild(backdrop);
    document.body.appendChild(panel);

    // Même seuil que Header.astro/MobileNav (CSS plus bas) : jamais un
    // état hybride où le drawer mobile resterait ouvert alors que la nav
    // desktop est déjà visible.
    const MOBILE_QUERY = "(max-width: 1099px)";
    const isMobile = () => window.matchMedia(MOBILE_QUERY).matches;

    // Verrouillage de scroll — cause #3 démontrée par l'audit :
    // `document.body.style.overflow = "hidden"` n'empêchait pas un
    // `scrollBy` programmatique (peu fiable sur iOS Safari en général).
    // Remplacé par la technique déjà éprouvée sur les 3 modales du site :
    // `position:fixed` + `top:-scrollY` + restauration exacte du style
    // inline précédent et de la position de scroll.
    let savedScrollY = 0;
    let savedBodyStyle: string | null = null;
    let inertedEls: HTMLElement[] = [];

    function lockScroll() {
      savedScrollY = window.scrollY;
      savedBodyStyle = document.body.getAttribute("style");
      document.body.style.position = "fixed";
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = "0";
      document.body.style.right = "0";
      document.body.style.width = "100%";
    }

    function unlockScroll() {
      if (savedBodyStyle) {
        document.body.setAttribute("style", savedBodyStyle);
      } else {
        document.body.removeAttribute("style");
      }
      window.scrollTo(0, savedScrollY);
    }

    // Empêche d'atteindre le contenu de page (liens du <main>, du Footer)
    // au clavier/lecteur d'écran pendant que le drawer est ouvert — le
    // <header> est explicitement EXCLU (le bouton hamburger doit rester
    // utilisable pour refermer, jamais placé dans un ancêtre aria-hidden),
    // de même que le backdrop/panel eux-mêmes (le drawer ne doit jamais
    // s'auto-masquer).
    function setInert() {
      inertedEls = Array.from(document.body.children).filter(
        (el): el is HTMLElement =>
          el instanceof HTMLElement && el !== header && el !== backdrop && el !== panel,
      );
      inertedEls.forEach((el) => {
        el.setAttribute("inert", "");
        el.setAttribute("aria-hidden", "true");
      });
    }

    function removeInert() {
      inertedEls.forEach((el) => {
        el.removeAttribute("inert");
        el.removeAttribute("aria-hidden");
      });
      inertedEls = [];
    }

    const openMenu = () => {
      toggle.setAttribute("aria-expanded", "true");
      panel.hidden = false;
      backdrop.hidden = false;
      lockScroll();
      setInert();
      const firstFocusable = panel.querySelector<HTMLElement>("a, button");
      firstFocusable?.focus();
      document.addEventListener("keydown", onKeydown);
    };

    const closeMenu = (options: { returnFocus?: boolean } = {}) => {
      const { returnFocus = true } = options;
      toggle.setAttribute("aria-expanded", "false");
      panel.hidden = true;
      backdrop.hidden = true;
      removeInert();
      unlockScroll();
      document.removeEventListener("keydown", onKeydown);
      if (returnFocus) toggle.focus();
    };

    function onKeydown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        closeMenu();
      }
    }

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    backdrop.addEventListener("click", () => closeMenu());

    panel.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest("a")) {
        // `returnFocus: false` : une navigation (changement de page) va
        // démonter ce document — inutile et potentiellement trompeur de
        // rendre le focus à un bouton sur le point de disparaître.
        closeMenu({ returnFocus: false });
      }
    });

    // Passage mobile -> desktop pendant que le menu est ouvert (rotation,
    // redimensionnement de fenêtre) : fermeture + nettoyage complet
    // (scroll/inert) plutôt que de laisser un drawer mobile ouvert
    // derrière une nav desktop désormais visible. Pas de `returnFocus` :
    // ce n'est pas une fermeture demandée par l'utilisateur sur le bouton.
    window.addEventListener("resize", () => {
      if (toggle.getAttribute("aria-expanded") === "true" && !isMobile()) {
        closeMenu({ returnFocus: false });
      }
    });
  }
</script>

<style>
  .mobile-nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    cursor: pointer;
  }

  /* Même breakpoint que Header.astro (CS-S4B) : jamais d'état hybride où
     le hamburger et le CTA/nav desktop coexisteraient ou se croiseraient. */
  @media (min-width: 1100px) {
    .mobile-nav__toggle {
      display: none;
    }
  }

  .mobile-nav__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mobile-nav__burger,
  .mobile-nav__burger::before,
  .mobile-nav__burger::after {
    content: "";
    display: block;
    width: 1.25rem;
    height: 2px;
    background: currentColor;
  }

  .mobile-nav__burger {
    position: relative;
  }

  .mobile-nav__burger::before {
    position: absolute;
    top: -6px;
    left: 0;
  }

  .mobile-nav__burger::after {
    position: absolute;
    top: 6px;
    left: 0;
  }

  .mobile-nav__backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 11, 13, 0.7);
    z-index: 60;
  }

  .mobile-nav__panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(20rem, 85vw);
    background: var(--color-surface);
    border-left: 1px solid var(--color-border-strong);
    z-index: 61;
    /* `top:0; bottom:0` (au lieu d'une hauteur fixe type `100vh`) suit
       déjà nativement la hauteur RÉELLE du viewport visuel, y compris
       quand les barres Safari iOS apparaissent/disparaissent — cette
       partie n'a pas besoin de `dvh`. `env(safe-area-inset-*)` ajoute en
       plus, de façon purement additive (0px de fallback sur tout appareil
       sans encoche/Dynamic Island), la marge nécessaire pour ne jamais
       faire passer le premier lien ou le CTA sous une zone système —
       NON VÉRIFIÉ sur un iPhone réel (pas d'environnement iOS disponible
       ici), à confirmer par Sébastien (voir rapport). */
    padding: calc(var(--space-xl) + env(safe-area-inset-top, 0px)) var(--space-md)
      calc(var(--space-md) + env(safe-area-inset-bottom, 0px)) var(--space-md);
    overflow-y: auto;
  }

  @media (min-width: 1100px) {
    .mobile-nav__backdrop,
    .mobile-nav__panel {
      display: none;
    }
  }

  .mobile-nav__group-title {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xs) 0;
  }

  .mobile-nav__list {
    list-style: none;
    margin: 0 0 var(--space-md) 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .mobile-nav__list--main {
    border-top: none;
  }

  .mobile-nav__list li {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav__list a {
    display: block;
    padding-block: 0.875rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: 1.0625rem;
  }

  .mobile-nav__list a[aria-current="page"] {
    color: var(--color-accent);
  }

  /* :global() : cette classe est passée à <ActionLink>, dont le <a> rendu
     porte le data-astro-cid d'ActionLink, pas celui de MobileNav (même
     cause que le bug Header CS-S4B) — sans :global() la règle ne
     s'appliquait jamais. */
  :global(.mobile-nav__cta) {
    width: 100%;
    margin-top: var(--space-sm);
  }
</style>
