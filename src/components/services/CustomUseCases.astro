---
// CustomUseCases — micro-sprint "Cas d'usage interactif" (PROMPT_CLAUDE_CODE_
// DEV_SUR_MESURE_CAS_USAGE_INTERACTIF), utilisé UNIQUEMENT par
// /developpement-sur-mesure/, section "Cas d'usage". Remplace l'ancienne
// liste de 6 étiquettes (`.service-chips`) + le diagramme "hub" (`.service-
// hub`, "Votre existant" + 4 nœuds) par 4 situations client cliquables + 1
// panneau explicatif.
//
// MÉCANISME — technique VOLONTAIREMENT identique à `CustomStartingPoint.astro`
// (section "Point de départ", juste au-dessus), pour la cohérence des
// interactions et de la DA demandée par le prompt (§ "s'en inspirer... SANS
// la modifier") : radios natifs cachés + <label> visible + panneau CSS pur
// sur desktop (les 4 panneaux restent dans la grille, jamais `display:none`,
// pour stabiliser la hauteur), modale mobile en JS (verrouillage de scroll,
// piège de focus, fermetures croix/backdrop/Échap) avec écoute `click` (pas
// `change`) sur chaque radio — reprend directement le correctif du bug
// "premier choix pré-sélectionné qui ne réagit pas au premier tap" déjà
// validé sur Point de départ, SANS jamais recopier l'ancien bug lui-même.
// `CustomStartingPoint.astro` n'est ni importé ni modifié : composant et
// classes CSS entièrement indépendants (`.custom-usecases-*`), aucun risque
// de collision ni de couplage entre les deux sections.
interface UseCase {
  id: string;
  label: string;
  icon: "link" | "cycle" | "trend" | "tool";
  title: string;
  situation: string;
  development: string;
  benefit: string;
}

interface Props {
  items: UseCase[];
}

const { items } = Astro.props as Props;
const GROUP_NAME = "custom-usecases";
const totalPadded = String(items.length).padStart(2, "0");
---

<div class="custom-usecases" data-motion="block">
  <fieldset class="custom-usecases__fieldset">
    <legend class="custom-usecases__legend">Choisissez votre situation</legend>
    <div class="custom-usecases__grid">
      {items.map((item: UseCase, index: number) => {
        const radioId = `${GROUP_NAME}-${item.id}`;
        const panelId = `${GROUP_NAME}-panel-${item.id}`;
        return (
          <div class="custom-usecases__item">
            <input
              type="radio"
              name={GROUP_NAME}
              id={radioId}
              class="custom-usecases__radio"
              checked={index === 0}
              aria-controls={panelId}
              data-item-id={item.id}
            />
            <label for={radioId} class="custom-usecases__choice">
              <span class="custom-usecases__icon" aria-hidden="true">
                {item.icon === "link" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                )}
                {item.icon === "cycle" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 8a8.5 8.5 0 0 0-15.5-3.5M3 4v4.5h4.5" />
                    <path d="M3 16a8.5 8.5 0 0 0 15.5 3.5M21 20v-4.5h-4.5" />
                  </svg>
                )}
                {item.icon === "trend" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                    <polyline points="17 6 23 6 23 12" />
                  </svg>
                )}
                {item.icon === "tool" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                  </svg>
                )}
              </span>
              <span class="custom-usecases__label">{item.label}</span>
            </label>
            <div class="custom-usecases__panel" id={panelId} aria-labelledby={radioId}>
              <p class="custom-usecases__panel-meta" aria-hidden="true">
                <span class="custom-usecases__panel-counter">{item.id}/{totalPadded}</span>
                <span class="custom-usecases__panel-meta-sep">·</span>
                <span class="custom-usecases__panel-meta-label">{item.label}</span>
              </p>
              <h3 class="custom-usecases__panel-title">{item.title}</h3>
              <div class="custom-usecases__panel-block">
                <span class="custom-usecases__panel-block-label">Votre situation</span>
                <p class="custom-usecases__panel-text">{item.situation}</p>
              </div>
              <div class="custom-usecases__panel-block">
                <span class="custom-usecases__panel-block-label">Ce que nous pouvons développer</span>
                <p class="custom-usecases__panel-text">{item.development}</p>
              </div>
              <div class="custom-usecases__panel-block">
                <span class="custom-usecases__panel-block-label">Ce que cela peut vous apporter</span>
                <p class="custom-usecases__panel-text">{item.benefit}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </fieldset>

  <script type="application/json" data-usecases is:inline set:html={JSON.stringify(items)} />

  <div class="custom-usecases__modal-backdrop" data-modal-backdrop hidden>
    <div
      class="custom-usecases__modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="custom-usecases-modal-title"
      data-modal
    >
      <button type="button" class="custom-usecases__modal-close" data-modal-close aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
      <div class="custom-usecases__modal-body" data-modal-body>
        <p class="custom-usecases__panel-meta" aria-hidden="true">
          <span class="custom-usecases__panel-counter" data-modal-counter></span>
          <span class="custom-usecases__panel-meta-sep">·</span>
          <span class="custom-usecases__panel-meta-label" data-modal-meta-label></span>
        </p>
        <h3 class="custom-usecases__panel-title" id="custom-usecases-modal-title" data-modal-title></h3>
        <div data-modal-blocks></div>
      </div>
    </div>
  </div>
</div>

<script>
  interface UseCaseData {
    id: string;
    label: string;
    icon: string;
    title: string;
    situation: string;
    development: string;
    benefit: string;
  }

  const BLOCK_LABELS: [key: "situation" | "development" | "benefit", label: string][] = [
    ["situation", "Votre situation"],
    ["development", "Ce que nous pouvons développer"],
    ["benefit", "Ce que cela peut vous apporter"],
  ];

  const root = document.querySelector<HTMLElement>(".custom-usecases");
  if (root) {
    const dataScript = root.querySelector<HTMLScriptElement>("[data-usecases]");
    const items: UseCaseData[] = dataScript ? JSON.parse(dataScript.textContent || "[]") : [];

    const backdrop = root.querySelector<HTMLElement>("[data-modal-backdrop]");
    const modal = root.querySelector<HTMLElement>("[data-modal]");
    const closeBtn = root.querySelector<HTMLButtonElement>("[data-modal-close]");
    const modalCounter = root.querySelector<HTMLElement>("[data-modal-counter]");
    const modalMetaLabel = root.querySelector<HTMLElement>("[data-modal-meta-label]");
    const modalTitle = root.querySelector<HTMLElement>("[data-modal-title]");
    const modalBlocks = root.querySelector<HTMLElement>("[data-modal-blocks]");
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>(".custom-usecases__radio"));
    const totalPadded = String(items.length).padStart(2, "0");

    if (
      backdrop &&
      modal &&
      closeBtn &&
      modalCounter &&
      modalMetaLabel &&
      modalTitle &&
      modalBlocks &&
      radios.length > 0
    ) {
      // Couche top-level non piégée : déplacée à la fin de <body> au montage
      // (même garde-fou que Point de départ, prompt mobile §"couvrant le
      // viewport").
      document.body.appendChild(backdrop);

      // Signale que le JS a pris le relais : masque le panneau inline en
      // dessous de 900px (voir services.css, `.custom-usecases--js`).
      root.classList.add("custom-usecases--js");

      const MOBILE_QUERY = "(max-width: 899px)";
      const isMobile = () => window.matchMedia(MOBILE_QUERY).matches;

      let lastTrigger: HTMLElement | null = null;
      let savedScrollY = 0;
      let savedBodyStyle: string | null = null;
      let inertedEls: HTMLElement[] = [];

      function lockScroll() {
        savedScrollY = window.scrollY;
        savedBodyStyle = document.body.getAttribute("style");
        document.body.style.position = "fixed";
        document.body.style.top = `-${savedScrollY}px`;
        document.body.style.left = "0";
        document.body.style.right = "0";
        document.body.style.width = "100%";
      }

      function unlockScroll() {
        if (savedBodyStyle) {
          document.body.setAttribute("style", savedBodyStyle);
        } else {
          document.body.removeAttribute("style");
        }
        window.scrollTo(0, savedScrollY);
      }

      function setInert() {
        inertedEls = Array.from(document.body.children).filter(
          (el): el is HTMLElement => el instanceof HTMLElement && el !== backdrop,
        );
        inertedEls.forEach((el) => {
          el.setAttribute("inert", "");
          el.setAttribute("aria-hidden", "true");
        });
      }

      function removeInert() {
        inertedEls.forEach((el) => {
          el.removeAttribute("inert");
          el.removeAttribute("aria-hidden");
        });
        inertedEls = [];
      }

      function getFocusable(container: HTMLElement) {
        return Array.from(
          container.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])',
          ),
        );
      }

      function onKeydown(event: KeyboardEvent) {
        if (event.key === "Escape") {
          closeModal();
          return;
        }
        if (event.key === "Tab" && modal) {
          const focusables = getFocusable(modal);
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      }

      function preventBackdropTouch(event: TouchEvent) {
        event.preventDefault();
      }

      function openModal(itemId: string, trigger: HTMLElement) {
        const item = items.find((i) => i.id === itemId);
        if (!backdrop || !item) return;

        modalCounter!.textContent = `${item.id}/${totalPadded}`;
        modalMetaLabel!.textContent = item.label;
        modalTitle!.textContent = item.title;
        modalBlocks!.innerHTML = "";
        BLOCK_LABELS.forEach(([key, label]) => {
          const block = document.createElement("div");
          block.className = "custom-usecases__panel-block";
          const labelEl = document.createElement("span");
          labelEl.className = "custom-usecases__panel-block-label";
          labelEl.textContent = label;
          const textEl = document.createElement("p");
          textEl.className = "custom-usecases__panel-text";
          textEl.textContent = item[key];
          block.appendChild(labelEl);
          block.appendChild(textEl);
          modalBlocks!.appendChild(block);
        });

        lastTrigger = trigger;
        lockScroll();
        setInert();
        backdrop.hidden = false;
        backdrop.addEventListener("touchmove", preventBackdropTouch, { passive: false });
        document.addEventListener("keydown", onKeydown);
        closeBtn!.focus();
      }

      function closeModal() {
        if (!backdrop || backdrop.hidden) return;
        backdrop.hidden = true;
        backdrop.removeEventListener("touchmove", preventBackdropTouch);
        document.removeEventListener("keydown", onKeydown);
        removeInert();
        unlockScroll();
        if (lastTrigger && lastTrigger.isConnected) lastTrigger.focus();
        lastTrigger = null;
      }

      closeBtn.addEventListener("click", () => closeModal());
      backdrop.addEventListener("click", (event) => {
        if (event.target === backdrop) closeModal();
      });
      modal.addEventListener("click", (event) => event.stopPropagation());

      // `click` (jamais `change`) sur chaque radio : se déclenche à CHAQUE
      // activation (tap, clic, label associé, Entrée/Espace), que l'état
      // coché change ou non — évite le bug "premier choix déjà sélectionné
      // qui ne réagit pas au premier tap" déjà corrigé sur Point de départ
      // (voir CustomStartingPoint.astro), reproduit ici dès l'écriture
      // initiale plutôt que recopié puis corrigé après coup.
      radios.forEach((radio) => {
        radio.addEventListener("click", () => {
          if (!isMobile()) return;
          openModal(radio.dataset.itemId || "", radio);
        });
      });

      window.addEventListener("resize", () => {
        if (backdrop && !backdrop.hidden && !isMobile()) closeModal();
      });
    }
  }
</script>
