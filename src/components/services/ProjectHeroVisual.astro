---
// ProjectHeroVisual — micro-sprint "Test Hero PROJET" pour
// /applications-metier-saas/ UNIQUEMENT (jamais importé par ServiceHero.astro
// ni par les 2 autres pages services : zéro risque de régression ailleurs).
// Utilise EXACTEMENT les 3 assets fournis par Sébastien
// (src/assets/hero-projet/), jamais retouchés/redessinés :
// - puce-projet.png  : image principale (chip PROJET + circuits gravés).
// - circuit_paths_complete.svg : 24 <path> (viewBox 0 0 1254 1254, même
//   cadre que le PNG) inlinés dans le DOM pour pouvoir appeler
//   getTotalLength()/getPointAtLength() dessus — le SVG reste invisible
//   (opacity:0), il ne sert que de guide de trajectoire, jamais affiché.
// - particle-orange.png : 6 particules HTML <img> maximum (micro-sprint
//   randomisation — doublé depuis 3), positionnées en `left/top` (%) le
//   long d'un path choisi, recalculées à chaque frame par un simple rAF
//   (pas de dépendance d'animation, pas de nouvelle lib). Taille et vitesse
//   sont re-tirées aléatoirement (facteur 0.7-1.3, uniforme) à CHAQUE
//   lancement/relance d'une particule — voir le bloc script plus bas.
//
// Positionnement PNG <-> SVG : les deux partagent le même conteneur carré
// (aspect-ratio:1/1) et le même système de coordonnées (0-1254) — un point
// SVG (x,y) se convertit donc directement en position CSS via
// `(x/1254)*100%` / `(y/1254)*100%`, sans recalcul au resize.
import { Picture } from "astro:assets";
import puceProjet from "../../assets/hero-projet/puce-projet.png";
import particleOrangeUrl from "../../assets/hero-projet/particle-orange.png?url";
import circuitPathsMarkup from "../../assets/hero-projet/circuit_paths_complete.svg?raw";

// Micro-sprint randomisation §3 — limite existante (3) lue puis doublée
// exactement, comme demandé ("ne pas inventer une nouvelle valeur").
const PARTICLE_COUNT = 6;
---

<div class="project-hero-visual" aria-hidden="true">
  <Picture
    src={puceProjet}
    alt=""
    formats={["avif", "webp"]}
    widths={[320, 480, 640]}
    sizes="(min-width: 900px) 22rem, 60vw"
    loading="eager"
    decoding="async"
    class="project-hero-visual__chip"
  />
  <div class="project-hero-visual__paths" set:html={circuitPathsMarkup} />
  {Array.from({ length: PARTICLE_COUNT }).map((_, i) => (
    <img
      src={particleOrangeUrl}
      alt=""
      class="project-hero-visual__particle"
      data-particle={i}
    />
  ))}
</div>

<style>
  /* Conteneur carré (même ratio que le viewBox 1254x1254) — respiration
     visuelle dans le Hero sans dominer le texte (prompt §8), jamais collé
     aux bords (marge via le grid parent, voir services.css).
     Micro-sprint "Hover 3D" — devient l'enveloppe carte + le wrapper
     GLOBAL du tilt : border-radius/overflow/box-shadow habillent la carte,
     et c'est CET élément (pas un enfant) qui reçoit le `transform`
     perspective/rotate/scale en JS (voir le bloc script plus bas), de sorte que puce +
     SVG + particules bougent comme un seul objet rigide sans qu'aucune de
     leurs logiques internes (positions %, échelle particule) n'ait besoin
     d'être modifiée : un transform sur le parent entraîne tous ses
     descendants avec lui, tel quel. */
  .project-hero-visual {
    position: relative;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    border-radius: var(--radius-xl);
    overflow: hidden;
    /* Contour cuivré discret (anneau 1px) + ombre Ember premium, sobres —
       tokens existants uniquement (--radius-xl, alpha du Ember officiel
       #E45F36 déjà utilisé tel quel ailleurs sur le site, ex. home.css),
       aucune nouvelle couleur/valeur de radius inventée. */
    box-shadow:
      0 22px 48px -26px rgba(228, 95, 54, 0.45),
      0 0 0 1px rgba(228, 95, 54, 0.18);
    will-change: transform;
  }

  /* Halo d'ambiance discret derrière la puce — même formule que le glow
     ember déjà utilisé ailleurs sur le site (Hero Home, CTA final),
     jamais une nouvelle couleur. Volontairement doux (pas de "feu
     d'artifice", prompt §2/§9). Micro-sprint "Hover 3D" §5 (option légère,
     secondaire) : le centre du halo suit maintenant `--px`/`--py` (mis à
     jour au pointermove, recentrés à 50%/50% au repos) pour un léger
     déplacement du glow avec le pointeur — aucune transition ajoutée sur
     ce fond : le pointermove met déjà à jour ces variables à haute
     fréquence, un `radial-gradient` à position dynamique reste subtil sans
     complexifier avec une interpolation de propriété personnalisée. */
  .project-hero-visual::before {
    content: "";
    /* `inset: 0` (jamais négatif) — un halo qui déborde de sa propre boîte
       poussait la page en scroll horizontal de quelques pixels sur cette
       colonne de droite (grid track déjà à sa largeur max) : contenu
       strictement à l'intérieur du conteneur, exigence explicite du
       prompt ("pas de débordement", "pas de scroll horizontal"). */
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--px, 50%) var(--py, 50%),
      rgba(228, 95, 54, 0.16),
      rgba(228, 95, 54, 0) 65%
    );
    z-index: 0;
    pointer-events: none;
  }

  .project-hero-visual__chip {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Le PNG source a un fond quasi noir (pas de canal alpha) : le mode de
       fusion "screen" annule visuellement le noir (0,0,0 n'apporte rien en
       screen) et ne laisse apparaître que les circuits lumineux, sans
       carré visible ni retouche manuelle de l'asset. */
    mix-blend-mode: screen;
  }

  /* Guide de trajectoire — jamais affiché graphiquement (prompt §4),
     seulement présent dans le DOM pour que le script puisse appeler
     getTotalLength()/getPointAtLength() sur ses <path>. opacity:0 (plutôt
     que display:none) : garde un layout réel, nécessaire pour que ces
     méthodes SVG restent fiables dans tous les navigateurs. */
  .project-hero-visual__paths {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .project-hero-visual__paths :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-hero-visual__particle {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: clamp(0.5rem, 1.6vw, 0.85rem);
    height: auto;
    opacity: 0;
    pointer-events: none;
    /* --particle-scale : facteur 0.7-1.3 re-tiré par le script à chaque
       lancement (micro-sprint randomisation §1) — la taille CSS de base
       (clamp responsive, INCHANGÉE) n'est jamais touchée, seule une
       échelle relative est appliquée par-dessus le centrage existant. */
    transform: translate(-50%, -50%) scale(var(--particle-scale, 1));
    filter: drop-shadow(0 0 6px rgba(228, 95, 54, 0.85));
    will-change: left, top, opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-hero-visual__particle {
      display: none;
    }

    /* Micro-sprint "Hover 3D" §8 — filet CSS pur en complément du garde-fou
       JS (initTilt ne s'attache même pas dans ce cas) : la carte reste
       strictement figée à l'état neutre, jamais de tilt. */
    .project-hero-visual {
      transform: none !important;
    }
  }
</style>

<script>
  // Animation vanilla JS, aucune dépendance : chaque particule (max 6
  // depuis le micro-sprint randomisation, PARTICLE_COUNT ci-dessus) suit
  // un <path> du SVG inliné via getPointAtLength(), en boucle, avec un
  // départ décalé par particule pour un effet de "flux entrants"
  // désynchronisés plutôt qu'un aller-retour synchronisé/mécanique.
  function initProjectHeroVisual(root: HTMLElement) {
    const paths = Array.from(root.querySelectorAll<SVGPathElement>(".project-hero-visual__paths path"));
    const particles = Array.from(root.querySelectorAll<HTMLImageElement>(".project-hero-visual__particle"));
    if (!paths.length || !particles.length) return;

    const VIEWBOX_SIZE = 1254;
    const BASE_DURATION_MS = 3400; // "pas trop rapide, pas trop lent" (prompt §6), vitesse de référence (facteur 1)
    const STAGGER_MS = 1250; // décalage des départs entre particules
    const FADE_FRACTION = 0.12; // fondu entrée/sortie, évite un "pop" visuel abrupt

    // Micro-sprint randomisation §1/§2 — tirage uniforme [0.7, 1.3],
    // ré-appelé à CHAQUE lancement/relance (dans runParticle ci-dessous),
    // jamais figé une fois pour toutes sur la durée de vie de la particule.
    const MIN_FACTOR = 0.7;
    const MAX_FACTOR = 1.3;
    const randomFactor = () => MIN_FACTOR + Math.random() * (MAX_FACTOR - MIN_FACTOR);

    // Ordre de parcours mélangé une seule fois au chargement (pas par
    // frame) : suffisant pour varier les côtés d'origine sans logique
    // d'aléatoire à gérer en continu (prompt §6, "pas d'aléatoire ingérable").
    const shuffledPaths = [...paths].sort(() => Math.random() - 0.5);

    function runParticle(el: HTMLImageElement, cycle: number) {
      const path = shuffledPaths[cycle % shuffledPaths.length];
      const totalLength = path.getTotalLength();

      // Nouveau tirage à CHAQUE lancement (prompt §1/§2) : taille et
      // vitesse varient indépendamment d'une particule à l'autre ET d'un
      // cycle à l'autre pour une même particule. Vitesse plus élevée =>
      // durée plus courte (durée = référence / facteur), comme demandé.
      const sizeFactor = randomFactor();
      const speedFactor = randomFactor();
      const durationMs = BASE_DURATION_MS / speedFactor;
      el.style.setProperty("--particle-scale", String(sizeFactor));

      let start: number | null = null;

      function frame(timestamp: number) {
        if (start === null) start = timestamp;
        const elapsed = timestamp - start;
        const progress = Math.min(elapsed / durationMs, 1);
        const point = path.getPointAtLength(progress * totalLength);

        el.style.left = (point.x / VIEWBOX_SIZE) * 100 + "%";
        el.style.top = (point.y / VIEWBOX_SIZE) * 100 + "%";
        el.style.opacity =
          progress < FADE_FRACTION
            ? String(progress / FADE_FRACTION)
            : progress > 1 - FADE_FRACTION
              ? String((1 - progress) / FADE_FRACTION)
              : "1";

        if (progress < 1) {
          requestAnimationFrame(frame);
        } else {
          const restartDelay = 400 + Math.random() * 700;
          window.setTimeout(() => runParticle(el, cycle + particles.length), restartDelay);
        }
      }

      requestAnimationFrame(frame);
    }

    particles.forEach((el, i) => {
      window.setTimeout(() => runParticle(el, i), i * STAGGER_MS);
    });
  }

  // Micro-sprint "Hover 3D" (PROMPT_CLAUDE_CODE_V2_HOVER_3D_PROJET_CANTRELLE)
  // — effet de carte 3D inspiré du mécanisme HeliFan (calcul pointeur ->
  // normalisation -1..1 -> rotate/scale), adapté à la DA sobre du studio.
  // Fonction totalement INDÉPENDANTE de `initProjectHeroVisual` ci-dessus :
  // elle ne lit/modifie AUCUN état des particules (positions, tailles,
  // vitesses, timings, anti-répétition, fade-out INCHANGÉS) et applique son
  // `transform` sur `.project-hero-visual` lui-même — le même élément qui
  // contient déjà la puce, le SVG et les particules, donc les trois bougent
  // mécaniquement comme un seul objet sans synchronisation à coder.
  function initTilt(root: HTMLElement) {
    // §7/§8 — pas de tilt sur tactile/pointeur imprécis, et jamais si
    // prefers-reduced-motion (vérifié par l'appelant, voir boot() plus bas).
    const pointerFine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (!pointerFine) return;

    const MAX_TILT_DEG = 8; // ±8deg (prompt §3)
    const HOVER_SCALE = 1.025; // prompt §3
    const PERSPECTIVE_PX = 1100; // prompt §3, "environ 1000 à 1200px"
    const TRACK_TRANSITION = "transform 90ms linear"; // §4 — quasi direct pendant le suivi
    const RETURN_TRANSITION = "transform 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94)"; // §4 — retour au repos

    function applyTransform(rotateXDeg: number, rotateYDeg: number, scale: number) {
      root.style.transform = `perspective(${PERSPECTIVE_PX}px) rotateX(${rotateXDeg}deg) rotateY(${rotateYDeg}deg) scale(${scale})`;
    }

    function onPointerMove(event: PointerEvent) {
      const rect = root.getBoundingClientRect();
      // Position du pointeur relative au CENTRE du composant, normalisée
      // entre -1 et 1 (prompt §3, mécanisme HeliFan repris conceptuellement).
      const x = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width) * 2 - 1));
      const y = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height) * 2 - 1));

      root.style.transition = TRACK_TRANSITION;
      // rotateY = x * max ; rotateX = y * -max (exemple conceptuel du prompt §3).
      applyTransform(y * -MAX_TILT_DEG, x * MAX_TILT_DEG, HOVER_SCALE);

      // §5 — glow léger réactif à la position pointeur, option secondaire :
      // simple mise à jour de 2 custom properties consommées par le
      // radial-gradient du halo (::before, voir le bloc style plus haut).
      root.style.setProperty("--px", `${((x + 1) / 2) * 100}%`);
      root.style.setProperty("--py", `${((y + 1) / 2) * 100}%`);
    }

    function onPointerLeave() {
      root.style.transition = RETURN_TRANSITION;
      applyTransform(0, 0, 1);
      root.style.setProperty("--px", "50%");
      root.style.setProperty("--py", "50%");
    }

    root.addEventListener("pointermove", onPointerMove);
    root.addEventListener("pointerleave", onPointerLeave);
  }

  function boot() {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const roots = document.querySelectorAll<HTMLElement>(".project-hero-visual");

    // Particules : comportement STRICTEMENT inchangé — reducedMotion
    // continue de désactiver entièrement `initProjectHeroVisual` (même
    // condition qu'avant ce micro-sprint, seulement restructurée pour
    // pouvoir aussi initialiser le tilt ci-dessous indépendamment). §7/§8.
    if (!reducedMotion) {
      roots.forEach(initProjectHeroVisual);
    }

    // Hover 3D : nouveau, indépendant. Ne s'attache pas du tout en
    // reduced-motion (§8) ; se désactive lui-même si le pointeur n'est pas
    // fin (§7, tactile).
    if (!reducedMotion) {
      roots.forEach(initTilt);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>
