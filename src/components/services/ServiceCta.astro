---
// ServiceCta — CS-S9. Bloc de conclusion partagé par les 3 pages services.
// CTA primaire commun (prompt §26 : "Parler de votre projet" → /contact/),
// CTA secondaire contextuel par page.
//
// HOTFIX CS-S11D — dette accessibilité identifiée en CS-S11A/CS-S11B : les
// pages appelantes posent un `aria-labelledby` sur la <section> qui
// enveloppe ce composant, mais son <h2> ne portait aucun id correspondant
// (référence ARIA cassée). Correction minimale et générique : prop
// optionnelle `headingId`, posée sur le <h2> uniquement si fournie —
// rétrocompatible à 100% (un appelant qui ne la passe pas garde un rendu
// strictement identique). Chaque page appelante doit désormais passer
// EXACTEMENT le même id que celui déjà utilisé par son propre
// `aria-labelledby` de section (voir methode.astro, applications-metier-
// saas.astro, sites-professionnels.astro, developpement-sur-mesure.astro,
// a-propos.astro).
import ActionLink from "../ui/ActionLink.astro";

// Micro-sprint "Reveal scroll Applications/Sites pro" — même principe et
// même prop `revealGranular` (défaut false, rétrocompatible à 100%) que
// ServiceHero.astro : remplace `data-motion="cta"` (1 bloc) par 4
// marqueurs par rôle, consommés UNIQUEMENT par l'orchestration dédiée aux
// 2 pages ciblées. Les autres appelants (a-propos, contact, développement
// sur mesure, développement web Amiens, méthode) gardent le marqueur
// unique et le comportement inchangé.
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  secondaryHref: string;
  secondaryLabel: string;
  headingId?: string;
  revealGranular?: boolean;
}

const { eyebrow, title, text, secondaryHref, secondaryLabel, headingId, revealGranular = false } = Astro.props;
---

<div class="service-cta" data-motion={revealGranular ? undefined : "cta"}>
  <span class="service-cta__eyebrow" data-motion={revealGranular ? "cta-eyebrow" : undefined}>{eyebrow}</span>
  <h2 id={headingId} class="service-cta__title" data-motion={revealGranular ? "cta-title" : undefined}>{title}</h2>
  <p class="service-cta__text" data-motion={revealGranular ? "cta-text" : undefined}>{text}</p>
  <div class="service-cta__actions" data-motion={revealGranular ? "cta-actions" : undefined}>
    <ActionLink href="/contact/" variant="primary">Parler de votre projet</ActionLink>
    <ActionLink href={secondaryHref} variant="secondary">{secondaryLabel}</ActionLink>
  </div>
</div>
