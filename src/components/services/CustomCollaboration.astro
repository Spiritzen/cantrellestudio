---
// CustomCollaboration — micro-sprint "Mode de collaboration, parcours
// interactif" (PROMPT_CLAUDE_CODE_DEV_SUR_MESURE_MODE_COLLABORATION_
// PARCOURS_INTERACTIF), utilisé UNIQUEMENT par /developpement-sur-mesure/,
// section "Mode de collaboration". Remplace la rangée statique de 5
// colonnes (`.service-process`, retirée du markup et de services.css —
// aucune autre référence dans le projet) par un parcours chronologique
// interactif en 5 étapes.
//
// VOLONTAIREMENT DIFFÉRENT de CustomStartingPoint.astro/CustomUseCases.astro
// (prompt §"OBJECTIF" : "SANS réutiliser... la modale mobile") : aucune
// modale ici. Mécanisme repris de la technique CSS pure déjà validée sur
// Sites professionnels (PositioningSituations.astro/ClientJourney.astro,
// NI modifiés NI importés) — radio natif cocher + <label> visible + panneau
// — mais adaptée : les 5 panneaux restent dans la grille desktop (jamais
// `display:none`, technique déjà affinée sur Point de départ/Cas d'usage
// pour stabiliser la hauteur), et l'accordéon mobile est 100% natif (aucun
// JS requis pour ouvrir/fermer une étape, donc structurellement impossible
// de reproduire le bug "premier item déjà actif, premier clic sans effet"
// observé sur les modales — ici il n'y a ni modale ni JS d'ouverture).
//
// Barre de progression : simple repère de LECTURE (jamais un indicateur de
// chargement/avancement réel d'un projet client, prompt §"Ce n'est PAS une
// progression automatique"), pilotée en CSS pur via `:has()` (déjà utilisé
// ailleurs dans le projet, ex. `main:has(.custom-cta-section)` — aucune
// nouvelle technique introduite) : 5 largeurs fixes (20/40/60/80/100%)
// selon le radio coché, aucun JS.
interface Step {
  id: string;
  icon: "discussion" | "audit" | "architecture" | "code" | "delivery";
  name: string;
  title: string;
  text: string;
  outcome: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props as Props;
const GROUP_NAME = "custom-collab";
const totalPadded = String(steps.length).padStart(2, "0");
---

<div class="custom-collab" data-motion="block">
  <fieldset class="custom-collab__fieldset">
    <legend class="custom-collab__legend">Étapes d'un projet sur mesure</legend>

    <div class="custom-collab__progress" aria-hidden="true">
      <div class="custom-collab__progress-track">
        <div class="custom-collab__progress-fill"></div>
      </div>
    </div>

    <div class="custom-collab__grid">
      {steps.map((step: Step, index: number) => {
        const radioId = `${GROUP_NAME}-${step.id}`;
        const panelId = `${GROUP_NAME}-panel-${step.id}`;
        return (
          <div class="custom-collab__item">
            <input
              type="radio"
              name={GROUP_NAME}
              id={radioId}
              class="custom-collab__radio"
              checked={index === 0}
              aria-controls={panelId}
            />
            <label for={radioId} class="custom-collab__choice">
              <span class="custom-collab__icon" aria-hidden="true">
                {step.icon === "discussion" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                  </svg>
                )}
                {step.icon === "audit" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                )}
                {step.icon === "architecture" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <line x1="3" y1="9" x2="21" y2="9" />
                    <line x1="9" y1="21" x2="9" y2="9" />
                  </svg>
                )}
                {step.icon === "code" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                {step.icon === "delivery" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l9 5v8l-9 5-9-5V8l9-5z" />
                    <path d="M3 8l9 5 9-5" />
                    <line x1="12" y1="21" x2="12" y2="13" />
                  </svg>
                )}
              </span>
              <span class="custom-collab__index" aria-hidden="true">{step.id}</span>
              <span class="custom-collab__name">{step.name}</span>
            </label>
            <div class="custom-collab__panel" id={panelId} aria-labelledby={radioId}>
              <p class="custom-collab__panel-meta" aria-hidden="true">
                <span class="custom-collab__panel-counter">Étape {step.id}/{totalPadded}</span>
                <span class="custom-collab__panel-meta-sep">·</span>
                <span class="custom-collab__panel-meta-name">{step.name}</span>
              </p>
              <h3 class="custom-collab__panel-title">{step.title}</h3>
              <p class="custom-collab__panel-text">{step.text}</p>
              <p class="custom-collab__panel-outcome">
                <span class="custom-collab__panel-outcome-label">Repère</span>
                {step.outcome}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </fieldset>
</div>
