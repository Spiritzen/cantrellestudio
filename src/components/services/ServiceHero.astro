---
// ServiceHero — CS-S9. Bloc d'ouverture partagé par les 3 pages services :
// eyebrow + H1 + lead + CTA. Volontairement simple (aucun motif visuel
// spécifique ici : l'architecture/diagramme propre à chaque page vit dans
// la page elle-même, pas dans ce composant — prompt §31, "leur composition
// centrale doit différer"). Aucune 3D, aucun JS : CSS/HTML statique.
//
// Micro-sprint "Reveal scroll Applications/Sites pro" — prop optionnelle
// `revealGranular` (défaut false, RÉTROCOMPATIBLE à 100%) : quand true,
// remplace l'unique marqueur `data-motion="hero"` (1 seul bloc, consommé
// par le reveal générique de ServiceMotion.astro) par 4 marqueurs distincts
// par rôle (`hero-eyebrow`/`hero-title`/`hero-lead`/`hero-actions`),
// consommés UNIQUEMENT par l'orchestration dédiée aux 2 pages ciblées
// (voir ServiceMotion.astro, `setupHeroGranular`). Les autres appelants
// (a-propos, contact, développement sur mesure, développement web Amiens,
// méthode) ne passent jamais cette prop : ils gardent EXACTEMENT le même
// marqueur unique et le même comportement qu'avant ce sprint.
import ActionLink from "../ui/ActionLink.astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  // Micro-change "Hero mots clés" (Applications métier & SaaS) — variante
  // avec balisage (ex. <strong>) pour surligner 2-3 mots précis dans le
  // lead, sans dépendre de contenu utilisateur (toujours une chaîne
  // statique écrite dans le frontmatter de la page). Optionnelle : les
  // 2 autres pages Services continuent de passer `lead` en texte brut,
  // rendu échappé comme avant, comportement strictement inchangé pour
  // elles.
  leadHtml?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref: string;
  secondaryLabel: string;
  revealGranular?: boolean;
}

const {
  eyebrow,
  title,
  lead,
  leadHtml,
  primaryHref = "/contact/",
  primaryLabel = "Parler de votre projet",
  secondaryHref,
  secondaryLabel,
  revealGranular = false,
} = Astro.props;
---

<div class="service-hero" data-motion={revealGranular ? undefined : "hero"}>
  <span class="service-hero__eyebrow" data-motion={revealGranular ? "hero-eyebrow" : undefined}>{eyebrow}</span>
  <h1 class="service-hero__title" data-motion={revealGranular ? "hero-title" : undefined}>{title}</h1>
  {leadHtml ? (
    <p class="service-hero__lead" data-motion={revealGranular ? "hero-lead" : undefined} set:html={leadHtml} />
  ) : (
    <p class="service-hero__lead" data-motion={revealGranular ? "hero-lead" : undefined}>{lead}</p>
  )}
  <div class="service-hero__actions" data-motion={revealGranular ? "hero-actions" : undefined}>
    <ActionLink href={primaryHref} variant="primary">{primaryLabel}</ActionLink>
    <ActionLink href={secondaryHref} variant="secondary">{secondaryLabel}</ActionLink>
  </div>
</div>
