ErrorDocument 404 /404.html

RewriteEngine On

# Canonical host: www -> non-www, toujours en HTTPS
RewriteCond %{HTTP_HOST} ^www\.cantrelle-studio\.com$ [NC]
RewriteRule ^ https://cantrelle-studio.com%{REQUEST_URI} [R=301,L,NE]

# Canonical scheme: HTTP -> HTTPS
# Garde-fou LWS/proxy : ne pas rediriger si X-Forwarded-Proto indique déjà HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://cantrelle-studio.com%{REQUEST_URI} [R=301,L,NE]

# Astro build assets: hashed filenames, safe for long-lived browser cache
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_astro/" astro_immutable=1
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=astro_immutable
</IfModule>
